{
    "name": "ShivaTrades-NEST",
    "version": "1.0.0",
    "description": "ShivaTrades Platform - NestJs Backend",
    "repository": {
        "type": "git",
        "url": "https://github.com/andrechristikan/ack-nestjs-boilerplate.git"
    },
    "private": true,
    "license": "MIT",
    "scripts": {
        "prepare": "husky",
        "prebuild": "rimraf dist",
        "clean": "rimraf dist && rimraf node_modules && yarn cache clean",
        "build": "nest build",
        "format": "prettier --write '{src,test}/**/*.{ts,json,yml,yaml}' && prettier --write '*.{ts,json,yml,yaml,mjs}'",
        "postinstall": "patch-package",
        "start": "nest start",
        "start:dev": "clear && nest start --watch",
        "start:prod": "node dist/main",
        "lint": "eslint",
        "lint:staged": "lint-staged",
        "lint:fix": "eslint --fix",
        "test": "TZ=UTC jest --config test/jest.json --passWithNoTests --forceExit",
        "deadcode": "ts-prune --project tsconfig.json --unusedInModule --skip *.json",
        "spell": "cspell lint --config cspell.json '{src,test}/**/*.ts' --color --gitignore --no-must-find-files --no-summary --no-progress || true",
        "package:upgrade": "npx npm-check-updates -u",
        "package:check": "npx npm-check-updates -i",
        "migrate:fresh": "yarn migrate:remove && yarn migrate:seed",
        "migrate:fresh-init": "nestjs-command seed:fresh-init",
        "trade:wipe": "nestjs-command trade:wipe",
        "trade:seed-masters": "nestjs-command trade:seed-masters",
        "trade:fresh": "nestjs-command trade:fresh",
        "migrate:seed": "nestjs-command seed:role && nestjs-command seed:user",
        "migrate:seed-ports": "nestjs-command seed:port-master",
        "seed:shivatrade": "nestjs-command seed:shivatrade-tenant",
        "migrate:remove": "nestjs-command remove:user && nestjs-command remove:role && nestjs-command remove:settings",
        "migrate:template": "nestjs-command migrate:emailTemplate",
        "rollback:template": "nestjs-command rollback:emailTemplate",
        "migrate:role-hierarchy": "nestjs-command migrate:role-hierarchy",
        "migrate:role-hierarchy-simple": "nestjs-command migrate:role-hierarchy-simple",
        "rollback:role-hierarchy": "nestjs-command rollback:role-hierarchy",
        "create:shared-users": "node scripts/create-shared-users.js",
        "migrate:tools-widgets-settings": "nestjs-command migrate:tools-widgets-settings",
        "migrate:plan-location-pricing": "nestjs-command migrate:plan-location-pricing",
        "rollback:plan-location-pricing": "nestjs-command rollback:plan-location-pricing",
        "migrate:plan-pricing-simplify": "nestjs-command migrate:plan-pricing-simplify",
        "rollback:plan-pricing-simplify": "nestjs-command rollback:plan-pricing-simplify",
        "migrate:plan-structure-cleanup": "nestjs-command migrate:plan-structure-cleanup",
        "rollback:plan-structure-cleanup": "nestjs-command rollback:plan-structure-cleanup",
        "migrate:tools-display-order": "nestjs-command migrate:tools-display-order",
        "rollback:tools-display-order": "nestjs-command rollback:tools-display-order",
        "migrate:tools-set-display-order": "nestjs-command migrate:tools-set-display-order",
        "seed:tools": "nestjs-command seed:tools",
        "remove:tools": "nestjs-command remove:tools",
        "seed:hrm-plans": "nestjs-command seed:hrm-plans",
        "remove:hrm-plans": "nestjs-command remove:hrm-plans",
        "update:role-permissions": "nestjs-command update:role-permissions",
        "sync:custom-role-permissions": "nestjs-command sync:custom-role-permissions",
        "seed:leave-types": "nestjs-command seed:leave-types",
        "remove:leave-types": "nestjs-command remove:leave-types",
        "seed:contract-templates": "nestjs-command seed:contract-templates",
        "seed:hrm-all": "yarn remove:tools && yarn remove:hrm-plans && yarn seed:tools && yarn seed:hrm-plans && yarn update:role-permissions && yarn sync:custom-role-permissions && yarn seed:leave-types && yarn seed:contract-templates",
        "seed:production": "nestjs-command seed:production",
        "seed:production-wipe": "nestjs-command seed:production-wipe"
    },
    "dependencies": {
        "@aws-sdk/client-ses": "^3.872.0",
        "@azure/msal-node": "^3.8.1",
        "@casl/ability": "^6.7.3",
        "@faker-js/faker": "^9.9.0",
        "@keyv/redis": "^5.1.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^11.0.3",
        "@nestjs/cache-manager": "^3.0.1",
        "@nestjs/common": "^11.1.5",
        "@nestjs/config": "^4.0.2",
        "@nestjs/core": "^11.1.5",
        "@nestjs/jwt": "^11.0.0",
        "@nestjs/passport": "^11.0.5",
        "@nestjs/platform-express": "^11.1.5",
        "@nestjs/schedule": "^6.0.1",
        "@nestjs/serve-static": "^5.0.3",
        "@nestjs/swagger": "^11.2.0",
        "@nestjs/terminus": "^11.0.0",
        "@nestjs/throttler": "^6.4.0",
        "@nestjs/typeorm": "^11.0.0",
        "@sentry/nestjs": "^10.1.0",
        "@sentry/profiling-node": "^10.1.0",
        "@tensorflow/tfjs-node": "^4.22.0",
        "@vladmandic/face-api": "^1.7.15",
        "axios": "^1.11.0",
        "bad-words": "^4.0.0",
        "bcryptjs": "^3.0.2",
        "bullmq": "^5.56.9",
        "cache-manager": "^7.1.0",
        "canvas": "^3.2.1",
        "case": "^1.6.3",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.2",
        "compress-pdf": "^0.5.5",
        "compression": "^1.8.1",
        "cron-parser": "^5.4.0",
        "crypto-js": "^4.2.0",
        "google-auth-library": "^10.2.1",
        "handlebars": "^4.7.8",
        "helmet": "^8.1.0",
        "html-pdf-node": "^1.0.8",
        "keyv": "^5.5.0",
        "luxon": "^3.7.1",
        "nanoid": "^5.1.6",
        "nest-commander": "^3.20.1",
        "nestjs-command": "^3.1.5",
        "nestjs-i18n": "^10.5.1",
        "nestjs-pino": "^4.4.0",
        "nodemailer": "^7.0.5",
        "passport": "^0.7.0",
        "passport-jwt": "^4.0.1",
        "patch-package": "^8.0.0",
        "pg": "^8.13.0",
        "pino": "^10.1.0",
        "pino-http": "^10.5.0",
        "pino-pretty": "^13.1.1",
        "puppeteer": "^24.29.1",
        "reflect-metadata": "^0.2.2",
        "response-time": "^2.3.4",
        "rotating-file-stream": "^3.2.6",
        "rxjs": "^7.8.2",
        "slugify": "^1.6.6",
        "stripe": "^20.1.0",
        "twilio": "^5.12.2",
        "typeorm": "^0.3.20",
        "verify-apple-id-token": "^3.1.2",
        "xlsx": "^0.18.5",
        "yargs": "17.7.2",
        "yarn": "^1.22.22"
    },
    "devDependencies": {
        "@commitlint/cli": "^19.8.1",
        "@commitlint/config-conventional": "^19.8.1",
        "@eslint/js": "^9.32.0",
        "@golevelup/ts-jest": "^0.7.0",
        "@nestjs/cli": "^11.0.10",
        "@nestjs/schematics": "^11.0.7",
        "@nestjs/testing": "^11.1.5",
        "@swc/cli": "^0.7.8",
        "@swc/core": "^1.13.3",
        "@swc/jest": "^0.2.39",
        "@types/bad-words": "^3.0.3",
        "@types/bytes": "^3.1.5",
        "@types/compression": "^1.8.1",
        "@types/cors": "^2.8.19",
        "@types/crypto-js": "^4.2.2",
        "@types/express": "^5.0.3",
        "@types/jest": "^30.0.0",
        "@types/lodash": "^4.17.20",
        "@types/luxon": "^3.7.1",
        "@types/ms": "^2.1.0",
        "@types/multer": "^2.0.0",
        "@types/node": "^24.2.0",
        "@types/passport-jwt": "^4.0.1",
        "@types/response-time": "^2.3.9",
        "@types/stripe": "^8.0.416",
        "@types/supertest": "^6.0.3",
        "@types/uuid": "^10.0.0",
        "cspell": "^9.2.0",
        "eslint": "^9.32.0",
        "eslint-config-prettier": "^10.1.8",
        "husky": "^9.1.7",
        "jest": "^30.0.5",
        "lint-staged": "^16.1.4",
        "prettier": "^3.6.2",
        "rimraf": "^6.0.1",
        "rxjs-marbles": "^7.0.1",
        "stop-only": "^3.4.3",
        "supertest": "^7.1.4",
        "ts-jest": "^29.4.1",
        "ts-node": "^10.9.2",
        "ts-prune": "^0.10.3",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.9.2",
        "typescript-eslint": "^8.39.0"
    },
    "lint-staged": {
        "**/*.ts": [
            "eslint",
            "stop-only --file"
        ],
        "*.{json,yaml}": [
            "prettier --write"
        ]
    },
    "packageManager": "yarn@1.22.22",
    "overrides": {},
    "engines": {
        "npm": ">= 8.0.0",
        "yarn": ">= 1.22.22",
        "node": ">= 20.11.0"
    }
}
