import {
    Controller,
    Get,
    Post,
    Put,
    Delete,
    Body,
    Query,
    HttpStatus,
    HttpCode,
    Param,
    Logger,
    UseGuards,
} from '@nestjs/common';
import {
    ApiTags,
    ApiOperation,
    ApiResponse,
    ApiQuery,
    ApiParam,
    ApiBearerAuth,
} from '@nestjs/swagger';
import { WidgetService } from '../services/widget.service';
import { WidgetGetRequestDto } from '../dtos/widget.get.dto';
import { WidgetUpdateRequestDto } from '../dtos/widget.update.dto';
import {
    WidgetCreateRequestDto,
    WidgetCreateResponseDto,
} from '../dtos/widget.create.dto';
import {
    WidgetDeleteResponseDto,
    WidgetRestoreResponseDto,
} from '../dtos/widget.delete.dto';
import {
    WidgetListResponseDto,
    WidgetUpdateResponseDto,
    WidgetItemResponseDto,
} from '../dtos/widget.response.dto';
import { WidgetDoc } from '../repository/entities/widget.entity';
import {
    AuthJwtAccessProtected,
    AuthJwtPayload,
} from '@modules/auth/decorators/auth.jwt.decorator';
import { UserProtected } from '@modules/user/decorators/user.decorator';
@ApiTags('widgets')
@UseGuards(TenantAccessGuard)
@RequiresTenantAccess()
@Controller({
    version: '1',
    path: '/widgets',
})
export class WidgetSharedController {
    private readonly logger = new Logger(WidgetSharedController.name);

    constructor(private readonly widgetService: WidgetService) { }

    @Get('')
    @HttpCode(HttpStatus.OK)
    @ApiOperation({
        summary: 'Get tenant user widgets',
        description:
            'Retrieve all widgets for the specified tenant user with metadata. Automatically provisions default widgets based on tenant tools on first access.',
    })
    @ApiQuery({
        name: 'tool_slug',
        required: false,
        description: 'Filter widgets by tool slug',
        example: 'wazuh',
    })
    @ApiResponse({
        status: HttpStatus.OK,
        description: 'Widgets retrieved successfully',
        type: WidgetListResponseDto,
    })
    @ApiResponse({
        status: HttpStatus.UNAUTHORIZED,
        description: 'Unauthorized access',
    })
    @ApiBearerAuth('accessToken')
    @UserProtected()
    @AuthJwtAccessProtected()
    async getWidgets(
        @AuthJwtPayload('tenantId') tenantId: string,
        @AuthJwtPayload('user') userId: string
        // @Query() query: WidgetGetRequestDto
    ): Promise<WidgetListResponseDto> {
        if (!tenantId || !userId) {
            return {
                widgets: [],
                metadata: [],
                invisibleMetaData: []
            };
        }
        const result = await this.widgetService.getUserWidgets(
            tenantId,
            userId
            // query.tool_slug
        );

        const InvisibleWidgets = await this.widgetService.findAllInvisibleWidgetsByUserId(
            tenantId,
            userId
        );

        return {
            widgets: result.widgets.map((widget: WidgetDoc) => ({
                _id: widget._id.toString(),
                user_id: widget?.user_id?.toString(),
                slug: widget.slug,
                order: widget.order,
                is_visible: widget.is_visible,
                tool_slug: widget.tool_slug,
                status: widget.status,
                soft_delete: widget.soft_delete,
                createdAt: widget.createdAt,
                updatedAt: widget.updatedAt,
            })),
            metadata: result.metadata,
            invisibleMetaData: InvisibleWidgets
        };
    }

    @Post('/update')
    @HttpCode(HttpStatus.OK)
    @ApiOperation({
        summary: 'Update tenant user widgets (bulk)',
        description:
            'Update widget order and visibility for the specified tenant user. Only allows modification of order and is_visible properties.',
    })
    @ApiResponse({
        status: HttpStatus.OK,
        description: 'Widgets updated successfully',
        type: WidgetUpdateResponseDto,
    })
    @ApiResponse({
        status: HttpStatus.BAD_REQUEST,
        description: 'Invalid request data',
    })
    @ApiResponse({
        status: HttpStatus.UNAUTHORIZED,
        description: 'Unauthorized access',
    })
    @ApiResponse({
        status: HttpStatus.FORBIDDEN,
        description: 'Access denied to one or more widgets',
    })
    @UserProtected()
    @AuthJwtAccessProtected()
    @ApiBearerAuth('accessToken')
    async updateWidgets(
        @AuthJwtPayload('tenantId') tenantId: string,
        @AuthJwtPayload('user') userId: string,
        @Body() updateRequest: WidgetUpdateRequestDto
    ): Promise<WidgetUpdateResponseDto> {
        const updatedWidgets = await this.widgetService.updateWidgets(
            tenantId,
            userId,
            updateRequest.widgets
        );

        return {
            message: 'Widgets updated successfully',
            widgets: updatedWidgets.map((widget: WidgetDoc) => ({
                _id: widget._id.toString(),
                user_id: widget.user_id?.toString(),
                slug: widget.slug,
                order: widget.order,
                is_visible: widget.is_visible,
                tool_slug: widget.tool_slug,
                status: widget.status,
                soft_delete: widget.soft_delete,
                createdAt: widget.createdAt,
                updatedAt: widget.updatedAt,
            })),
        };
    }
}
