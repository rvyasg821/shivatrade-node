<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .payment-summary {
        display: inline-block;
        margin: 20px auto;
        padding: 20px 32px;
        background-color: #f5f9ff;
        border: 1px solid #008ecc;
        border-radius: 8px;
        font-family: Poppins, sans-serif;
        text-align: left;
        max-width: 500px;
        width: 100%;
    }
    .payment-summary p {
        margin: 8px 0;
        font-size: 14px;
        color: #333;
    }
    .payment-summary strong {
        color: #000000;
    }
    .highlight {
        color: #000000;
        font-weight: 600;
    }
    .next-renewal {
        display: inline-block;
        margin: 16px auto;
        padding: 12px 28px;
        background-color: #e3f2fd;
        border-left: 4px solid #008ecc;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 600;
        color: #006699;
        font-family: Poppins, sans-serif;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 650px; margin:0 auto; background-color:#fff;'
    >

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 0 20px;'
        >
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 36px; color: #000000;'
            >
                Payment Confirmed
            </h3>
        </div>

        <!-- Greeting -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 10px 20px 0;'
        >
            <p
                style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #555;'
            >
                Hello
                <span style='font-weight: 600;'>{{name}}</span>,
            </p>
        </div>

        <!-- Body Content -->
        <div
            class='content'
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 32px 20px;'
        >

            <p
                style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0 0 16px; font-weight: 500; color: #333;'
            >
                Account Email:
                <strong>{{email}}</strong>
            </p>

            <!-- Payment Summary Box -->
            <div class='payment-summary'>
                <p><strong>Transaction ID:</strong>
                    <span class='highlight'>{{transation_id}}</span></p>
                <p><strong>Paid via:</strong> {{method}} through {{gateway}}</p>
                {{#if locations}}
                <p><strong>Locations:</strong> {{locations}}</p>
                {{/if}}
                <p><strong>Date & Time:</strong> {{postDateTime}}</p>
                <p><strong>Status:</strong>
                    <span class='highlight'>{{status}}</span></p>
            </div>

            <!-- Next Renewal Highlight -->
            <div class='next-renewal'>
                Next Billing Date:
                <strong>{{next_date}}</strong>
            </div>

            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 20px 0 0; font-weight: 400; color: #555; line-height: 1.6; max-width: 560px; margin-left: auto; margin-right: auto;'
            >
                {{{content}}}
            </p>

        </div>

        <!-- Support Footer -->
        <div
            class='footer'
            style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'
            >
                Have questions about your subscription or billing?
            </p>
            <ul style='list-style-type: none; padding: 0; margin: 0;'>
                <li
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0;'
                >
                    <a
                        href='mailto:{{{supportEmail}}}'
                        style='color: #000000; text-decoration: none; font-weight: 500;'
                    >
                        {{{supportEmail}}}
                    </a>
                </li>
            </ul>
        </div>

        <!-- Bottom Branding -->
        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>