<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .otp-code {
        display: inline-block;
        margin: 20px 0;
        font-size: 32px;
        font-weight: bold;
        color: #000000;
        background-color: #f0f8ff;
        padding: 16px 32px;
        border: 2px dashed #008ecc;
        border-radius: 8px;
        letter-spacing: 4px;
        font-family: 'Courier New', monospace;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div class='container--' style='max-width: 650px; margin:0 auto; background-color:#fff;'>
        
        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div style='text-align: center; max-width: 500px; margin: 0 auto; padding: 0 20px;'>
            <h3 style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 36px; color: #000000;'>
                Verify Your Email
            </h3>
        </div>

        <!-- Body Content -->
        <div class='content' style='text-align: center; max-width: 600px; margin: 0 auto; padding: 32px 20px;'>
            <p style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0 0 16px; font-weight: 500; color: #333;'>
                You're almost there! Please use the One-Time Password (OTP) below to complete your sign-up on <strong>PeopleGem</strong>.
            </p>

            <!-- OTP Display -->
            <div class='otp-code'>{{otp}}</div>

            <p style='font-size: 14px; font-family: Poppins, sans-serif; margin: 20px 0 0; font-weight: 400; color: #666;'>
                This OTP is valid for the next <strong>10 minutes</strong>. Do not share it with anyone.
            </p>

            <p style='font-size: 14px; font-family: Poppins, sans-serif; margin: 16px 0 0; font-weight: 500; color: #333;'>
                Didn’t request this? You can safely ignore this email.
            </p>
        </div>

        <!-- Support Section -->
        <div class='footer' style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'>
            <p style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'>
                Need help? Our support team is here for you.
            </p>
            <ul style='list-style-type: none; padding: 0; margin: 0;'>
                <li style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0; color: #000000;'>
                    <a href='mailto:{{{supportEmail}}}' style='color: #008ecc; text-decoration: none; font-weight: 500;'>
                        {{{supportEmail}}}
                    </a>
                </li>
            </ul>
        </div>

        <!-- Bottom Footer -->
        <div style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'>
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>