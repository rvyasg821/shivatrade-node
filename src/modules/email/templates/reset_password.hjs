<html>
    <head></head>
    <body>
        <h1>Dear {{name}}</h1>
        <p>Click on link for reset password.</p>
        <table border='0' cellpadding='1' cellspacing='1' style='width:70%'>
            <tbody>
                <tr>
                    <td><a
                            href='{{resetPasswordFrontLink}}/{{text.reset_token}}'
                        >Reset Password</a></td>
                </tr>
            </tbody>
        </table>
    </body>
</html>