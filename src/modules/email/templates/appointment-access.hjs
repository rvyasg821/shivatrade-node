<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .credentials-box {
        background-color: #f8f9fa;
        border-radius: 8px;
        padding: 20px;
        margin: 20px auto;
        max-width: 350px;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 650px; margin:0 auto; background-color:#fff;'
    >
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <div style='text-align: center; max-width: 400px; margin: 0 auto;'>
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; padding: 10px 0; font-size: 32px; color: #333;'
            >Your PeopleGem Access is Ready!</h3>
        </div>

        <div style='text-align: center; max-width: 400px; margin: 0 auto;'>
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400;'
            >
                Hello
                <span style='font-weight: 500;'>{{name}}</span>,
            </p>
        </div>

        <div
            class='content'
            style='text-align: center; width: 100%; padding-bottom: 30px; max-width: 600px; margin: 0 auto; padding: 32px 20px;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 auto; font-weight: 400; line-height: 1.6;'
            >
                Congratulations! Your subscription for <strong>{{companyName}}</strong> has been successfully activated.
                You now have access to the PeopleGem Appointment Management System.
            </p>

            <div class='credentials-box' style='background-color: #f8f9fa; border-radius: 8px; padding: 20px; margin: 25px auto; max-width: 350px; border: 1px solid #e9ecef;'>
                <p style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 15px 0; font-weight: 600; color: #333;'>
                    Your Login Credentials:
                </p>
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0; font-weight: 400;'
                >
                    <strong>Email:</strong>
                    {{email}}
                </p>
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0; font-weight: 400;'
                >
                    <strong>Password:</strong>
                    {{password}}
                </p>
            </div>

            <p
                style='font-size: 13px; font-family: Poppins, sans-serif; margin: 15px 0; font-weight: 400; color: #666;'
            >
                Please log in using the credentials above. For your security, we
                strongly recommend changing your password after your first login.
            </p>
        </div>

        <div style='text-align: center; padding-bottom: 32px;'>
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0; font-weight: 500;'
            >
                <a
                    href='{{loginUrl}}'
                    target='_blank'
                    class='login-btn'
                    style='color: #fff; background-color: #008ecc; border-radius: 5px; border: 2px solid #008ecc; text-decoration: none; padding: 12px 35px; display: inline-block;'
                >
                    Login to PeopleGem
                </a>
            </p>
        </div>

        <div
            style='background-color: #fff8e6; border-radius: 8px; padding: 15px 20px; margin: 0 32px 32px 32px; border-left: 4px solid #ffc107;'
        >
            <p
                style='font-size: 13px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #664d03;'
            >
                <strong>What's Next?</strong><br/>
                - Set up your business locations<br/>
                - Add your team members<br/>
                - Configure your services and working hours<br/>
                - Start accepting appointments!
            </p>
        </div>

        <div
            class='footer'
            style='text-align: center; padding: 32px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400;'
            >
                If you have any questions or need assistance, our support team is here to help.
            </p>
            <ul style='list-style-type: none; padding: 0; margin: 15px 0 0 0;'>
                <li
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 10px 0;'
                >
                    Contact our support team at
                    <a
                        href='mailto:{{{supportEmail}}}'
                        style='color: #008ecc;'
                    >{{{supportEmail}}}</a>
                </li>
            </ul>
        </div>

        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div
                style='text-align: center; justify-content: center; align-items: center;'
            >
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>
