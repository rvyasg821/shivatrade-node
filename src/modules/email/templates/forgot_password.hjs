<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .otp-code {
        display: inline-block;
        margin: 24px auto;
        font-size: 34px;
        font-weight: bold;
        color: #008ecc;
        background-color: #f0f8ff;
        padding: 18px 36px;
        border: 2px dashed #008ecc;
        border-radius: 10px;
        letter-spacing: 6px;
        font-family: 'Courier New', monospace;
        text-align: center;
        max-width: 400px;
    }
    .expiry-note {
        display: inline-block;
        margin: 16px auto;
        padding: 10px 24px;
        background-color: #fff8e1;
        border-left: 4px solid #ffb300;
        border-radius: 6px;
        font-size: 14px;
        font-weight: 500;
        color: #b37400;
        font-family: Poppins, sans-serif;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 650px; margin:0 auto; background-color:#fff;'
    >

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 0 20px;'
        >
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 36px; color: #008ecc;'
            >
                Password Reset OTP
            </h3>
        </div>

        <!-- Greeting -->
        {{#if text.content}}
            <div
                style='text-align: center; max-width: 500px; margin: 0 auto; padding: 10px 20px 0;'
            >
                <p
                    style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #555;'
                >
                    Hello
                    <span style='font-weight: 600;'>{{text.content.name}}</span>,
                </p>
            </div>
        {{/if}}

        <!-- Body Content -->
        <div
            class='content'
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 32px 20px;'
        >

            {{#if text.content}}
                <p
                    style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0 0 16px; font-weight: 500; color: #333;'
                >
                    Use the One-Time Password (OTP) below to reset your
                    password:
                </p>

                <!-- OTP Display -->
                <div class='otp-code'>{{text.content.otp}}</div>

                <!-- Expiry Note -->
                <div class='expiry-note'>
                    This OTP expires in
                    <strong>{{text.content.expiresIn}}</strong>
                    minutes.
                </div>
            {{/if}}

            {{#if text.email}}
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 20px 0 0; font-weight: 500; color: #666;'
                >
                    Account Email:
                    <strong>{{text.email}}</strong>
                </p>
            {{/if}}

        </div>

        <!-- Footer -->
        {{#if text.footer}}
            <div
                class='footer'
                style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'
            >
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'
                >
                    If you didn’t request a password reset, please ignore this
                    email.
                </p>
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0; font-weight: 500; color: #333;'
                >
                    Thank you,<br />
                    <strong style='color: #008ecc;'>PeopleGem Team</strong>
                </p>
            </div>
        {{/if}}

        <!-- Bottom Branding -->
        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>