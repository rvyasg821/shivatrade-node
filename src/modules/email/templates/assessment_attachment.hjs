<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .username {
        font-size: 20px;
        font-weight: 600;
        color: #000;
        margin-bottom: 16px;
        font-family: Poppins, sans-serif;
    }
</style>

<div style='background-color: #edf0f3; padding-top:20px;'>
    <div style='max-width: 650px; margin:0 auto; background-color:#fff;'>

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div style='text-align: center; margin: 0 auto; padding: 0 20px;'>
            <h3 style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 32px; color: #000000;'>
                Your Assessment Report
            </h3>
        </div>

        <!-- Message Section -->
        <div style='text-align: left; max-width: 600px; margin: 0 auto; padding: 32px 20px; font-family: Poppins, sans-serif; color: #333;'>
            
            <!-- Username -->
            <p class="username">Hello {{name}},</p>

            <!-- Body -->
            <p style='font-size: 16px; font-weight: 400; margin: 0 0 16px;'>
                Thank you for completing the security assessment. Your detailed report has been successfully generated.
            </p>

            <p style='font-size: 16px; font-weight: 400; margin: 0 0 16px;'>
                Please find the attached PDF containing your full assessment summary.
            </p>

            <p style='font-size: 16px; font-weight: 500; margin-top: 24px;'>
                If you have any questions or would like help understanding the report, feel free to contact our support team.
            </p>
        </div>

        <!-- Bottom Footer -->
        <div style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'>
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>

    </div>
</div>
