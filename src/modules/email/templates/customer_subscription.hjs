<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .expiry-alert {
        display: inline-block;
        margin: 20px auto;
        padding: 18px 32px;
        background-color: #fff3e0;
        border: 1px solid #ff9800;
        border-left: 5px solid #ff9800;
        border-radius: 8px;
        font-family: Poppins, sans-serif;
        text-align: center;
        max-width: 500px;
        width: 100%;
    }
    .expiry-alert strong {
        color: #e65100;
        font-size: 18px;
    }
    .highlight {
        color: #e65100;
        font-weight: 600;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 650px; margin:0 auto; background-color:#fff;'
    >

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='PeopleGem Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 0 20px;'
        >
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 36px; color: #000000;'
            >
                Plan Expiry Reminder
            </h3>
        </div>

        <!-- Greeting -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 10px 20px 0;'
        >
            <p
                style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #555;'
            >
                Hello
                <span style='font-weight: 600;'>{{name}}</span>,
            </p>
        </div>

        <!-- Body Content -->
        <div
            class='content'
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 32px 20px;'
        >

            <p
                style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0 0 16px; font-weight: 500; color: #333;'
            >
                Account Email:
                <strong>{{email}}</strong>
            </p>

            <!-- Expiry Alert Box -->
            <div class='expiry-alert'>
                Your plan expires in
                <strong class='highlight'>{{count}}</strong>
                days.
            </div>

            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 20px 0 0; font-weight: 400; color: #555; line-height: 1.6; max-width: 560px; margin-left: auto; margin-right: auto;'
            >
                {{{content}}}
            </p>

        </div>

        <!-- Support Footer -->
        <div
            class='footer'
            style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'
            >
                Need to renew or upgrade your plan?
            </p>
            <ul style='list-style-type: none; padding: 0; margin: 0;'>
                <li
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0;'
                >
                    <a
                        href='mailto:{{{supportEmail}}}'
                        style='color: #ff9800; text-decoration: none; font-weight: 500;'
                    >
                        {{{supportEmail}}}
                    </a>
                </li>
            </ul>
        </div>

        <!-- Bottom Branding -->
        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='PeopleGem Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>