<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .renewal-alert {
        display: inline-block;
        margin: 20px auto;
        padding: 18px 32px;
        background-color: #fff8e1;
        border: 1px solid #ffb300;
        border-left: 5px solid #ff8f00;
        border-radius: 8px;
        font-family: Poppins, sans-serif;
        text-align: center;
        max-width: 520px;
        width: 100%;
    }
    .renewal-alert strong {
        color: #e65100;
        font-size: 16px;
    }
    .highlight {
        color: #ff8f00;
        font-weight: 600;
    }
    .details-table {
        width: 100%;
        max-width: 520px;
        margin: 24px auto;
        border-collapse: collapse;
        font-family: Poppins, sans-serif;
        border: 1px solid #e0e0e0;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 2px 6px rgba(0, 0, 0, 0.05);
    }
    .details-table th {
        background-color: #f5f7fa;
        padding: 14px;
        font-size: 15px;
        font-weight: 600;
        text-align: center;
        color: #1a1a1a;
        border-bottom: 1px solid #e0e0e0;
    }
    .details-table td {
        padding: 12px 16px;
        font-size: 14px;
        border-bottom: 1px solid #eee;
    }
    .details-table td:first-child {
        font-weight: 500;
        color: #333;
        background-color: #fafafa;
        text-align: left;
    }
    .details-table td:last-child {
        text-align: right;
        color: #000;
    }
    .details-table tr:last-child td {
        border-bottom: none;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 650px; margin:0 auto; background-color:#fff;'
    >

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='ShivaTrade Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div
            style='text-align: center; max-width: 500px; margin: 0 auto; padding: 0 20px;'
        >
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 36px; color: #ff8f00;'
            >
                Renewal Reminder
            </h3>
        </div>

        <!-- Greeting -->
        {{#name}}
            <div
                style='text-align: center; max-width: 500px; margin: 0 auto; padding: 10px 20px 0;'
            >
                <p
                    style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #555;'
                >
                    Hello
                    <span style='font-weight: 600;'>{{name}}</span>,
                </p>
            </div>
        {{/name}}

        <!-- Body Content -->
        <div
            class='content'
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 32px 20px;'
        >

            {{#email}}
                <p
                    style='font-size: 16px; font-family: Poppins, sans-serif; margin: 0 0 16px; font-weight: 500; color: #333;'
                >
                    Account Email:
                    <strong>{{email}}</strong>
                </p>
            {{/email}}

            {{#next_date}}
                <!-- Renewal Alert -->
                <div class='renewal-alert'>
                    <p style='margin: 0; font-size: 15px;'>
                        Your next payment is due in
                        <strong class='highlight'>{{days_left}}</strong>
                        day(s) on
                        <strong>{{next_date}}</strong>.
                    </p>
                </div>
            {{/next_date}}

            <!-- Subscription Details Table -->
            <table class='details-table'>
                <thead>
                    <tr>
                        <th colspan='2'>Subscription Details</th>
                    </tr>
                </thead>
                <tbody>
                    {{#plan_name}}
                        <tr>
                            <td>Plan Name</td>
                            <td>{{plan_name}}</td>
                        </tr>
                    {{/plan_name}}

                    {{#plan_type}}
                        <tr>
                            <td>Plan Type</td>
                            <td>{{plan_type}}</td>
                        </tr>
                    {{/plan_type}}

                    {{#plan_price}}
                        <tr>
                            <td>Price</td>
                            <td>{{plan_price}}</td>
                        </tr>
                    {{/plan_price}}

                    {{#card_last4}}
                        <tr>
                            <td>Payment Method</td>
                            <td>Card ending in ****{{card_last4}}</td>
                        </tr>
                    {{/card_last4}}

                    {{#gateway}}
                        <tr>
                            <td>Payment Processor</td>
                            <td
                                style='text-transform: uppercase;'
                            >{{gateway}}</td>
                        </tr>
                    {{/gateway}}
                </tbody>
            </table>

            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 24px 0 0; font-weight: 500; color: #555; max-width: 560px; margin-left: auto; margin-right: auto;'
            >
                Please ensure your payment method has sufficient funds to avoid
                any service interruption.
            </p>

            {{#domain}}
                <p
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 20px 0 0; font-weight: 500; color: #333;'
                >
                    Manage your subscription at:
                    <a
                        href='{{domain}}'
                        style='color: #ff8f00; text-decoration: none; font-weight: 600;'
                    >
                        {{domain}}
                    </a>
                </p>
            {{/domain}}

        </div>

        <!-- Support Footer -->
        <div
            class='footer'
            style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'
            >
                Need to update your payment method or have questions?
            </p>
            <ul style='list-style-type: none; padding: 0; margin: 0;'>
                <li
                    style='font-size: 14px; font-family: Poppins, sans-serif; margin: 8px 0;'
                >
                    <a
                        href='mailto:{{{supportEmail}}}'
                        style='color: #ff8f00; text-decoration: none; font-weight: 500;'
                    >
                        {{{supportEmail}}}
                    </a>
                </li>
            </ul>
        </div>

        <!-- Bottom Branding -->
        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='ShivaTrade Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>