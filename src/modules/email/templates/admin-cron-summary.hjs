<style>
    .content h2 {
        font-size: 36px;
        font-weight: 700;
        padding-bottom: 32px;
    }
    .footer p {
        margin-bottom: 0;
    }
    .summary-box {
        display: inline-block;
        margin: 20px auto;
        padding: 18px 32px;
        background-color: #f5f5f5;
        border: 1px solid #ddd;
        border-left: 5px solid #2196f3;
        border-radius: 8px;
        font-family: Poppins, sans-serif;
        text-align: left;
        max-width: 550px;
        width: 100%;
    }
    .success-box {
        background-color: #e8f5e9;
        border-color: #4caf50;
        border-left-color: #4caf50;
    }
    .warning-box {
        background-color: #fff3e0;
        border-color: #ff9800;
        border-left-color: #ff9800;
    }
    .error-box {
        background-color: #ffebee;
        border-color: #f44336;
        border-left-color: #f44336;
    }
    .info-row {
        margin: 8px 0;
        font-size: 14px;
        color: #333;
    }
    .info-label {
        font-weight: 600;
        color: #1976d2;
        display: inline-block;
        min-width: 180px;
    }
    .highlight-success {
        color: #2e7d32;
        font-weight: 600;
    }
    .highlight-warning {
        color: #f57c00;
        font-weight: 600;
    }
    .highlight-error {
        color: #c62828;
        font-weight: 600;
    }
    .stat-number {
        font-size: 24px;
        font-weight: 700;
    }
    .payment-table {
        width: 100%;
        border-collapse: collapse;
        margin: 15px 0;
        font-size: 13px;
    }
    .payment-table th {
        background-color: #f5f5f5;
        padding: 10px;
        text-align: left;
        border-bottom: 2px solid #ddd;
    }
    .payment-table td {
        padding: 8px 10px;
        border-bottom: 1px solid #eee;
    }
    .payment-table tr:hover {
        background-color: #f9f9f9;
    }
    .status-success {
        color: #2e7d32;
        font-weight: 600;
    }
    .status-failed {
        color: #c62828;
        font-weight: 600;
    }
</style>

<div class='header-top' style='background-color: #edf0f3; padding-top:20px;'>
    <div
        class='container--'
        style='max-width: 700px; margin:0 auto; background-color:#fff;'
    >

        <!-- Logo -->
        <div style='padding: 32px 0px; text-align: center;'>
            <img
                alt='{{appName}} Logo'
                src="{{{logo}}}"
                style='height: auto; width: auto; max-width: 200px;'
            />
        </div>

        <!-- Title -->
        <div
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 0 20px;'
        >
            <h3
                style='font-family: Poppins; font-weight: 700; margin: 0; font-size: 28px; color: #000000;'
            >
                {{cronJobIcon}} {{cronJobName}} - Summary Report
            </h3>
        </div>

        <!-- Execution Time -->
        <div
            style='text-align: center; max-width: 600px; margin: 0 auto; padding: 10px 20px 0;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0; font-weight: 400; color: #666;'
            >
                Executed at: {{executionTime}}
            </p>
        </div>

        <!-- Body Content -->
        <div
            class='content'
            style='text-align: center; max-width: 650px; margin: 0 auto; padding: 32px 20px;'
        >

            <!-- Summary Stats Box -->
            <div class='summary-box {{summaryBoxClass}}'>
                <div class='info-row'>
                    <span class='info-label'>Total Processed:</span>
                    <span class='stat-number'>{{totalProcessed}}</span>
                </div>
                <div class='info-row'>
                    <span class='info-label'>Successful:</span>
                    <span class='stat-number highlight-success'>{{successCount}}</span>
                </div>
                <div class='info-row'>
                    <span class='info-label'>Failed:</span>
                    <span class='stat-number {{#if hasFailures}}highlight-error{{else}}highlight-success{{/if}}'>{{failedCount}}</span>
                </div>
                {{#if totalAmount}}
                <div class='info-row'>
                    <span class='info-label'>Total Amount Collected:</span>
                    <span class='stat-number highlight-success'>{{currencySymbol}}{{totalAmount}}</span>
                </div>
                {{/if}}
                {{#if duration}}
                <div class='info-row'>
                    <span class='info-label'>Execution Duration:</span>
                    <span>{{duration}}</span>
                </div>
                {{/if}}
            </div>

            {{#if payments}}
            <!-- Payment Details Table -->
            <div style='text-align: left; margin-top: 30px;'>
                <h4 style='font-family: Poppins; font-size: 18px; margin-bottom: 15px; color: #333;'>
                    Payment Details
                </h4>
                <table class='payment-table'>
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Amount</th>
                            <th>Gateway</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each payments}}
                        <tr>
                            <td>{{this.companyName}}</td>
                            <td>{{this.email}}</td>
                            <td>{{../currencySymbol}}{{this.amount}}</td>
                            <td>{{this.gateway}}</td>
                            <td class='{{#if this.success}}status-success{{else}}status-failed{{/if}}'>
                                {{#if this.success}}Success{{else}}Failed{{/if}}
                            </td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{/if}}

            {{#if expiringSubscriptions}}
            <!-- Expiring Subscriptions -->
            <div style='text-align: left; margin-top: 30px;'>
                <h4 style='font-family: Poppins; font-size: 18px; margin-bottom: 15px; color: #f57c00;'>
                    Subscriptions Expiring Soon ({{expiringCount}})
                </h4>
                <table class='payment-table'>
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Plan</th>
                            <th>Expires On</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each expiringSubscriptions}}
                        <tr>
                            <td>{{this.companyName}}</td>
                            <td>{{this.email}}</td>
                            <td>{{this.planName}}</td>
                            <td>{{this.expiryDate}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{/if}}

            {{#if expiredTrials}}
            <!-- Expired Trials -->
            <div style='text-align: left; margin-top: 30px;'>
                <h4 style='font-family: Poppins; font-size: 18px; margin-bottom: 15px; color: #c62828;'>
                    Expired Trial Subscriptions ({{expiredTrialsCount}})
                </h4>
                <table class='payment-table'>
                    <thead>
                        <tr>
                            <th>Company</th>
                            <th>Email</th>
                            <th>Plan</th>
                            <th>Expired On</th>
                        </tr>
                    </thead>
                    <tbody>
                        {{#each expiredTrials}}
                        <tr>
                            <td>{{this.companyName}}</td>
                            <td>{{this.email}}</td>
                            <td>{{this.planName}}</td>
                            <td>{{this.expiredDate}}</td>
                        </tr>
                        {{/each}}
                    </tbody>
                </table>
            </div>
            {{/if}}

            {{#if errors}}
            <!-- Errors -->
            <div style='text-align: left; margin-top: 30px;'>
                <h4 style='font-family: Poppins; font-size: 18px; margin-bottom: 15px; color: #c62828;'>
                    Errors ({{errorsCount}})
                </h4>
                <div style='background-color: #ffebee; padding: 15px; border-radius: 8px; font-size: 13px;'>
                    {{#each errors}}
                    <p style='margin: 5px 0; color: #c62828;'>
                        <strong>{{this.subscriptionId}}:</strong> {{this.message}}
                    </p>
                    {{/each}}
                </div>
            </div>
            {{/if}}

            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 30px 0 0; font-weight: 400; color: #555; line-height: 1.6;'
            >
                This is an automated report from the subscription cron job system.
            </p>

        </div>

        <!-- Support Footer -->
        <div
            class='footer'
            style='text-align: center; padding: 32px 20px; margin: 0 auto; max-width: 600px; border-top: 1px solid #00000029;'
        >
            <p
                style='font-size: 14px; font-family: Poppins, sans-serif; margin: 0 0 12px; font-weight: 400; color: #555;'
            >
                {{appName}} Admin Dashboard
            </p>
        </div>

        <!-- Bottom Branding -->
        <div
            style='width: 100%; background-color:#edf0f3; text-align:center; padding:26px 0px;'
        >
            <div style='text-align: center;'>
                <a href='{{frontUrl}}' target='_blank' style='text-decoration: none;'>
                    <img
                        alt='{{appName}} Logo'
                        src="{{{logo}}}"
                        style='height: auto; width: auto; max-width: 200px;'
                    />
                </a>
            </div>
        </div>
    </div>
</div>
