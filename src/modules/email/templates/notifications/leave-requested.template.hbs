<html>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #2563eb;">New Leave Request</h2>
    <p>Hi {{admin_name}},</p>
    <p><strong>{{employee_name}}</strong> has submitted a leave request that requires your attention.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold; width: 40%;">Leave Type</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{leave_type}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">From</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{start_date}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">To</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{end_date}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Total Days</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{total_days}}</td></tr>
      {{#if reason}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Reason</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{reason}}</td></tr>{{/if}}
      {{#if location_name}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Location</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{location_name}}</td></tr>{{/if}}
    </table>
    <p>Please log in to review and take action on this request.</p>
    {{#if frontUrl}}<p><a href="{{frontUrl}}" style="display: inline-block; padding: 10px 20px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 5px;">Go to Dashboard</a></p>{{/if}}
  </div>
</body>
</html>
