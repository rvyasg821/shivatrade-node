<html>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #d97706;">Shift Updated</h2>
    <p>Hi {{employee_name}},</p>
    <p>Your shift on <strong>{{shift_date}}</strong> has been updated.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold; width: 40%;">Date</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{shift_date}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Shift</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{shift_name}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Start Time</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{start_time}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">End Time</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{end_time}}</td></tr>
      {{#if location_name}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Location</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{location_name}}</td></tr>{{/if}}
    </table>
    <p>Please review the updated details and contact your manager if you have any questions.</p>
    {{#if frontUrl}}<p><a href="{{frontUrl}}" style="display: inline-block; padding: 10px 20px; background: #d97706; color: #fff; text-decoration: none; border-radius: 5px;">View My Shifts</a></p>{{/if}}
  </div>
</body>
</html>
