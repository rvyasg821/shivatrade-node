<html>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #2563eb;">New Compliance Event</h2>
    <p>Hi {{admin_name}},</p>
    <p>A new compliance event has been raised for the following employee that may require your attention.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold; width: 40%;">Employee</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{employee_name}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Event Type</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{event_type}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Event Date</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{event_date}}</td></tr>
      {{#if description}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Description</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{description}}</td></tr>{{/if}}
      {{#if reporting_deadline}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #fffbeb; font-weight: bold; color: #f59e0b;">Reporting Deadline</td><td style="padding: 8px; border: 1px solid #e5e7eb; color: #f59e0b; font-weight: bold;">{{reporting_deadline}}</td></tr>{{/if}}
      {{#if location_name}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Location</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{location_name}}</td></tr>{{/if}}
    </table>
    <p>Please log in to review the event details and take any necessary action.</p>
    {{#if frontUrl}}<p><a href="{{frontUrl}}" style="display: inline-block; padding: 10px 20px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 5px;">Review Compliance Event</a></p>{{/if}}
    <p style="font-size: 12px; color: #9ca3af;">This is an automated compliance notification. Please do not reply to this email.</p>
  </div>
</body>
</html>
