<html>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #dc2626;">Shift Swap Rejected</h2>
    <p>Hi {{requester_name}},</p>
    <p>Your shift swap request for <strong>{{swap_date}}</strong> has been <strong style="color: #dc2626;">rejected</strong> by {{rejected_by}}.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold; width: 40%;">Date</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{swap_date}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Rejected By</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{rejected_by}}</td></tr>
      {{#if admin_notes}}<tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Notes</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{admin_notes}}</td></tr>{{/if}}
    </table>
    <p>If you have any questions, please contact your manager.</p>
    {{#if frontUrl}}<p><a href="{{frontUrl}}" style="display: inline-block; padding: 10px 20px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 5px;">View My Shifts</a></p>{{/if}}
  </div>
</body>
</html>
