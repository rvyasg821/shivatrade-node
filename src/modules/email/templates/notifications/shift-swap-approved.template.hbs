<html>
<body style="font-family: Arial, sans-serif; line-height: 1.6; color: #333;">
  <div style="max-width: 600px; margin: 0 auto; padding: 20px;">
    <h2 style="color: #16a34a;">Shift Swap Approved</h2>
    <p>Hi {{requester_name}},</p>
    <p>Your shift swap for <strong>{{swap_date}}</strong> has been <strong style="color: #16a34a;">approved</strong> by {{approved_by}}.</p>
    <table style="width: 100%; border-collapse: collapse; margin: 15px 0;">
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold; width: 40%;">Requester</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{requester_name}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Swap Partner</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{target_name}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Date</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{swap_date}}</td></tr>
      <tr><td style="padding: 8px; border: 1px solid #e5e7eb; background: #f9fafb; font-weight: bold;">Approved By</td><td style="padding: 8px; border: 1px solid #e5e7eb;">{{approved_by}}</td></tr>
    </table>
    <p>Your shifts have been swapped. Please check your updated schedule.</p>
    {{#if frontUrl}}<p><a href="{{frontUrl}}" style="display: inline-block; padding: 10px 20px; background: #16a34a; color: #fff; text-decoration: none; border-radius: 5px;">View My Shifts</a></p>{{/if}}
  </div>
</body>
</html>
