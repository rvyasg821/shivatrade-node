import {
    CanActivate,
    ExecutionContext,
    ForbiddenException,
    Injectable,
    Logger,
} from '@nestjs/common';
import { IRequestApp } from '@common/request/interfaces/request.interface';
import { AuthService } from '@modules/auth/services/auth.service';
import { UserService } from '@modules/user/services/user.service';
import { IUserDoc, IUserEntity } from '@modules/user/interfaces/user.interface';
import { ENUM_USER_STATUS } from '@modules/user/enums/user.enum';
import { ENUM_USER_STATUS_CODE_ERROR } from '@modules/user/enums/user.status-code.enum';
import { ENUM_ROLE_STATUS_CODE_ERROR } from '@modules/role/enums/role.status-code.enum';
import { Reflector } from '@nestjs/core';
import { USER_GUARD_EMAIL_VERIFIED_META_KEY } from '@modules/user/constants/user.constant';
import { IUnifiedAuthJwtAccessTokenPayload } from '@modules/auth/interfaces/auth.unified.interface';
import { ENUM_SHARED_USER_TYPE } from '@modules/shared-users/repository/entities/shared-user.entity';
@Injectable()
export class UserGuard implements CanActivate {
    private readonly logger = new Logger(UserGuard.name);

    constructor(
        private readonly reflector: Reflector,
        private readonly userService: UserService,
        private readonly authService: AuthService,) { }

    async canActivate(context: ExecutionContext): Promise<boolean> {
        const emailVerified = this.reflector.get<boolean[]>(
            USER_GUARD_EMAIL_VERIFIED_META_KEY,
            context.getHandler()
        ) || [];

        const request = context.switchToHttp().getRequest<IRequestApp>();

        // Extract the full JWT payload from request.user
        const jwtPayload = request.user as IUnifiedAuthJwtAccessTokenPayload;

        if (!jwtPayload) {
            throw new ForbiddenException({
                statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                message: 'user.error.notFound',
            });
        }

        const { user: userId, userType, tenantId } = jwtPayload;

        let userWithRole: IUserDoc | TenantUserDoc;

        try {
            // Route to appropriate validation based on user type
            switch (userType) {
                case ENUM_SHARED_USER_TYPE.ADMIN:
                case ENUM_SHARED_USER_TYPE.COMPANY_ADMIN:
                    userWithRole = await this.validateSuperAdminOrCompanyAdmin(userId);
                    break;

                case ENUM_SHARED_USER_TYPE.TENANT_USER:
                    if (!tenantId) {
                        throw new ForbiddenException({
                            statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                            message: 'user.error.tenantIdRequired',
                        });
                    }
                    userWithRole = await this.validateTenantUser(userId, tenantId);
                    break;

                default:
                    throw new ForbiddenException({
                        statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                        message: 'user.error.invalidUserType',
                    });
            }

            // Common validation for all user types
            this.validateUserStatus(userWithRole, userType);
            this.validateRoleStatus(userWithRole, userType);

            // Password expiry validation (only for regular users, tenant users might not have passwordExpired field)
            if (userType !== ENUM_SHARED_USER_TYPE.TENANT_USER && (userWithRole as IUserDoc).passwordExpired) {
                const checkPasswordExpired: boolean = this.authService.checkPasswordExpired((userWithRole as IUserDoc).passwordExpired);
                if (checkPasswordExpired) {
                    throw new ForbiddenException({
                        statusCode: ENUM_USER_STATUS_CODE_ERROR.PASSWORD_EXPIRED,
                        message: 'auth.error.passwordExpired',
                    });
                }
            }

            // Set user data in request context
            if (userType === ENUM_SHARED_USER_TYPE.TENANT_USER) {
                // For tenant users, we need to set the user data differently since it has a different structure
                const tenantUser = userWithRole as TenantUserDoc;
                request.__user = {
                    _id: tenantUser._id.toString(),
                    name: tenantUser.name,
                    email: tenantUser.email,
                    role: tenantUser.role,
                    status: tenantUser.status,
                    isActive: tenantUser.isActive,
                    // Add other necessary fields that might be expected downstream
                    userType: userType,
                    tenantId: tenantId,
                } as any;
            } else {
                request.__user = (userWithRole as IUserDoc).toObject<IUserEntity>();
            }

            return true;

        } catch (error) {
            this.logger.error(`UserGuard validation failed for user ${userId} (${userType}):`, error);

            // Re-throw ForbiddenException as-is, wrap other errors
            if (error instanceof ForbiddenException) {
                throw error;
            }

            throw new ForbiddenException({
                statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                message: 'user.error.validationFailed',
            });
        }
    }

    /**
     * Validate Super Admin or Company Admin users using master database
     */
    private async validateSuperAdminOrCompanyAdmin(userId: string): Promise<IUserDoc> {
        const userWithRole: IUserDoc = await this.userService.findOneWithRoleAndCountryById(userId);

        if (!userWithRole) {
            throw new ForbiddenException({
                statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                message: 'user.error.notFound',
            });
        }

        return userWithRole;
    }

    /**
     * Validate Tenant User using tenant-specific database
     */
    private async validateTenantUser(userId: string, tenantId: string): Promise<TenantUserDoc> {
        try {
            // Establish connection to tenant database
            const tenantConnection = await this.tenantConnectionService.getConnection(tenantId);

            // Perform validation within tenant context
            return await this.tenantContextService.run({ tenantId, connection: tenantConnection }, async () => {
                // Fetch tenant user with role information
                const tenantUserWithRole = await this.tenantUserService.findOneWithRole(userId);

                if (!tenantUserWithRole) {
                    throw new ForbiddenException({
                        statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                        message: 'user.error.notFound',
                    });
                }

                return tenantUserWithRole;
            });

        } catch (error) {
            this.logger.error(`Failed to validate tenant user ${userId} in tenant ${tenantId}:`, error);

            if (error instanceof ForbiddenException) {
                throw error;
            }

            throw new ForbiddenException({
                statusCode: ENUM_USER_STATUS_CODE_ERROR.NOT_FOUND,
                message: 'user.error.tenantValidationFailed',
            });
        }
    }

    /**
     * Validate user status (active/inactive)
     */
    private validateUserStatus(user: IUserDoc | TenantUserDoc, userType: ENUM_SHARED_USER_TYPE): void {
        if (userType === ENUM_SHARED_USER_TYPE.TENANT_USER) {
            // For tenant users, check the tenant-specific status
            const tenantUser = user as TenantUserDoc;
            if (tenantUser.status !== ENUM_TENANT_USER_STATUS.ACTIVE) {
                throw new ForbiddenException({
                    statusCode: ENUM_USER_STATUS_CODE_ERROR.INACTIVE_FORBIDDEN,
                    message: 'user.error.inactive',
                });
            }
        } else {
            // For regular users, check the standard status
            const regularUser = user as IUserDoc;
            if (regularUser.status !== ENUM_USER_STATUS.ACTIVE) {
                throw new ForbiddenException({
                    statusCode: ENUM_USER_STATUS_CODE_ERROR.INACTIVE_FORBIDDEN,
                    message: 'user.error.inactive',
                });
            }
        }
    }

    /**
     * Validate role status (active/inactive)
     */
    private validateRoleStatus(user: IUserDoc | TenantUserDoc, userType: ENUM_SHARED_USER_TYPE): void {
        if (userType === ENUM_SHARED_USER_TYPE.TENANT_USER) {
            // For tenant users, the role is populated differently
            const tenantUser = user as TenantUserDoc;
            if (!tenantUser.role || (typeof tenantUser.role === 'object' && !(tenantUser.role as any).isActive)) {
                throw new ForbiddenException({
                    statusCode: ENUM_ROLE_STATUS_CODE_ERROR.INACTIVE_FORBIDDEN,
                    message: 'role.error.inactive',
                });
            }
        } else {
            // For regular users
            const regularUser = user as IUserDoc;
            if (!regularUser.role || !regularUser.role.isActive) {
                throw new ForbiddenException({
                    statusCode: ENUM_ROLE_STATUS_CODE_ERROR.INACTIVE_FORBIDDEN,
                    message: 'role.error.inactive',
                });
            }
        }
    }
}
