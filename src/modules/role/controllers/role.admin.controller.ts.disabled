    @RoleAdminCreateDoc()
    @Response('role.create')
    @Permission('role', 'can_add')
    @UseGuards(PermissionGuard)
    @UserProtected()
    @AuthJwtAccessProtected()
    @Post('/create')
    async create(
        @Body()
        { name, description, type, permissions }: RoleCreateRequestDto,
        @Req() request: Request,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>('userType') userType: string
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        const user = (request as any).user;
        const currentUserLevel = user.roleLevel || 1;

        // Check if role name already exists
        const existingRole = await this.roleService.existByName(name);
        if (existingRole) {
            throw new ConflictException('Role name already exists');
        }

        // Get the level that would be assigned to the new role
        const newRoleLevel = await this.roleService.getNextRoleLevel(name);

        // Validate hierarchy - user can only create roles at or above their level
        if (!this.roleService.validateRoleHierarchy(currentUserLevel, newRoleLevel)) {
            throw new RoleHierarchyInsufficientLevelException(
                currentUserLevel,
                newRoleLevel,
                'create'
            );
        }
        const companyId = await this.companyService.findOneByUserId(user._id);

        // Determine the actual companyId to use
        let actualCompanyId = companyId?._id;

        // For users with level > 1, use their companyId from middleware
        if (currentUserLevel > 1) {
            actualCompanyId = user.companyId;

            // if (!actualCompanyId) {
            //     throw new ConflictException(
            //         'User must belong to a company to create roles'
            //     );
            // }

            // Force custom type for non-admin users (level > 2)
            if (type === ENUM_ROLE_TYPE.SYSTEM && currentUserLevel > 2) {
                throw new ConflictException(
                    'Insufficient permissions to create system roles'
                );
            }
        }

        // // Validate companyId for custom roles
        // if (type === ENUM_ROLE_TYPE.CUSTOM && !actualCompanyId) {
        //     throw new ConflictException('Company ID is required for custom roles');
        // }

        // System roles cannot have companyId
        if (type === ENUM_ROLE_TYPE.SYSTEM && actualCompanyId) {
            throw new ConflictException('System roles cannot have company ID');
        }

        const create = await this.roleService.create({
            name,
            description,
            type,
            companyId: actualCompanyId?.toString(),
            permissions,
        });

        return {
            data: { _id: String(create._id) },
        };
    }

    @RoleAdminUpdateDoc()
    @Response('role.update')
    @Permission('role', 'can_update')
    @UseGuards(PermissionGuard)
    @UserProtected()
    @AuthJwtAccessProtected()
    @Put('/update/:role')
    async update(
        @Param('role', RequestRequiredPipe) role: string,
        @Body()
        {
            description,
            name,
            permissions,
            type,
            companyId,
        }: RoleUpdateRequestDto,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>('role')
        currentUserRole: string,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>() userPayloadToken: any,
        @Req() request: Request
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        const user = (request as any).user;

        // Check if user is Tenant User or Company Admin and handle tenant-specific role update
        const userType: ENUM_SHARED_USER_TYPE = userPayloadToken?.userType;
        const tenantId: string = userPayloadToken?.tenantId;

        if (
            userType &&
            (userType === ENUM_SHARED_USER_TYPE.TENANT_USER ||
                userType === ENUM_SHARED_USER_TYPE.COMPANY_ADMIN) &&
            tenantId
        ) {
            // Handle tenant-specific role update
            const tenantConnection = null;
            // Perform update within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId, connection: tenantConnection }, async () => {
                console.log('Updating role in tenant database:', role);
                // Find the role in tenant database
                const tenantRole = await this.tenantRoleService.findOneById(role);
                if (!tenantRole) {
                    throw new NotFoundException(
                        'Role not found in tenant database'
                    );
                }

                // Check hierarchy for tenant role update
                const currentUserLevel = user.roleLevel || 1;
                const canManageTenantRole = this.tenantRoleService.validateTenantRoleHierarchy(currentUserLevel, tenantRole.level);

                if (!canManageTenantRole) {
                    throw new TenantRoleHierarchyInsufficientLevelException(
                        currentUserLevel,
                        tenantRole.level,
                        tenantId,
                        'update'
                    );
                }

                // Get current user role from tenant database for permission validation
                let currentUserTenantRole = null;

                if (userType === ENUM_SHARED_USER_TYPE.COMPANY_ADMIN) {
                    currentUserTenantRole =
                        await this.roleService.findOneById(currentUserRole);
                } else {
                    currentUserTenantRole =
                        await this.tenantRoleService.findOneById(currentUserRole);
                }
                // currentUserTenantRole = await this.tenantRoleService.findOneById(currentUserRole);
                if (!currentUserTenantRole) {
                    throw new ConflictException(
                        'Current user role not found in tenant database'
                    );
                }

                // Check if new name conflicts with existing role (if name is being changed)
                if (name !== tenantRole.name) {
                    const existingRole =
                        await this.tenantRoleService.findOneByName(name);
                    if (
                        existingRole &&
                        String(existingRole._id) !== String(tenantRole._id)
                    ) {
                        throw new ConflictException('Role name already exists');
                    }
                }

                const currentUserPermissionsData =
                    currentUserTenantRole.permissions;
                const permissionsKeys = Object.keys(permissions);

                // Validate that the current user has all the permissions they are trying to assign
                for (const moduleKey of permissionsKeys) {
                    const modulePermissions = permissions[moduleKey];
                    const creatorModulePermissions =
                        currentUserPermissionsData[moduleKey];

                    // If creator has no permissions for this module, skip
                    if (!creatorModulePermissions) {
                        throw new BadRequestException(
                            `You do not have permission to assign this module '${moduleKey}'`
                        );
                    }

                    for (const permissionKey of Object.keys(modulePermissions)) {
                        const permissionValue = modulePermissions[permissionKey];

                        // Only validate if creator is trying to assign a TRUE permission
                        if (
                            permissionValue === true &&
                            creatorModulePermissions[permissionKey] !== true
                        ) {
                            throw new BadRequestException(
                                `You do not have permission to assign '${permissionKey}' on module '${moduleKey}'`
                            );
                        }
                    }
                }

                // Update the role in tenant database
                await this.tenantRoleService.update(tenantRole, {
                    description,
                    name,
                    permissions,
                });

                return {
                    data: { _id: String(tenantRole._id) },
                };
            });
        }

        const roleDoc: RoleDoc = await this.roleService.findOneById(role);
        // Original logic for non-tenant users
        // Check if user can manage this role based on hierarchy
        const currentUserLevel = user.roleLevel || 1;
        const canManage = this.roleService.validateRoleHierarchy(currentUserLevel, roleDoc.level);

        if (!canManage) {
            throw new RoleHierarchyInsufficientLevelException(
                currentUserLevel,
                roleDoc.level,
                'update'
            );
        }

        // Check if new name conflicts with existing role (if name is being changed)
        if (name !== roleDoc.name) {
            const existingRole = await this.roleService.findOneByName(name);
            if (
                existingRole &&
                String(existingRole._id) !== String(roleDoc._id)
            ) {
                throw new ConflictException('Role name already exists');
            }
        }

        if (userPayloadToken?.roleName === ENUM_SHARED_USER_TYPE.ADMIN) {
            await this.roleService.update(roleDoc, {
                description,
                name,
                permissions,
                type,
                companyId,
            });

            return {
                data: { _id: String(roleDoc._id) },
            };
        }

        const CurrentUserPermissions =
            await this.roleService.findOneById(currentUserRole);

        const currentUserPermissionsData = CurrentUserPermissions.permissions;
        const permissionsKeys = Object.keys(permissions);

        for (const moduleKey of permissionsKeys) {
            const modulePermissions = permissions[moduleKey];
            const creatorModulePermissions =
                currentUserPermissionsData[moduleKey];

            if (!creatorModulePermissions) {
                throw new BadRequestException(
                    `You do not have permission to assign this module '${moduleKey}'`
                );
            }

            for (const permissionKey of Object.keys(modulePermissions)) {
                const permissionValue = modulePermissions[permissionKey];
                if (
                    permissionValue === true &&
                    creatorModulePermissions[permissionKey] !== true
                ) {
                    throw new BadRequestException(
                        `You do not have permission to assign '${permissionKey}' on module '${moduleKey}'`
                    );
                }
            }
        }

        await this.roleService.update(roleDoc, {
            description,
            name,
            permissions,
            type,
            companyId,
        });

        return {
            data: { _id: String(roleDoc._id) },
        };
    }

    @RoleAdminInactiveDoc()
    @Response('role.inactive')
    @Permission('role', 'can_update')
    @UseGuards(PermissionGuard)
    @UserProtected()
    @AuthJwtAccessProtected()
    @Patch('/update/:role/inactive')
    async inactive(
        @Param('role', RequestRequiredPipe) role: string,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>() userPayloadToken: any,
        @Req() request: Request
    ): Promise<void> {
        const user = (request as any).user;

        // Check if user is Tenant User or Company Admin and handle tenant-specific role deactivation
        const userType: ENUM_SHARED_USER_TYPE = userPayloadToken?.userType;
        const tenantId: string = userPayloadToken?.tenantId;

        if (
            userType &&
            (userType === ENUM_SHARED_USER_TYPE.TENANT_USER ||
                userType === ENUM_SHARED_USER_TYPE.COMPANY_ADMIN) &&
            tenantId
        ) {
            // Handle tenant-specific role deactivation
            const tenantConnection = null;
            // Perform deactivation within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId, connection: tenantConnection }, async () => {
                // Find the role in tenant database
                const tenantRole = await this.tenantRoleService.findOneById(role);
                if (!tenantRole) {
                    throw new NotFoundException(
                        'Role not found in tenant database'
                    );
                }

                // Check if role is currently active
                if (!tenantRole.isActive) {
                    throw new BadRequestException('Role is already inactive');
                }

                // Update the role to inactive in tenant database
                await this.tenantRoleService.update(tenantRole, {
                    isActive: false,
                });
            });
        }

        // Original logic for non-tenant users
        const roleDoc: RoleDoc = await this.roleService.findOneById(role);
        if (!roleDoc) {
            throw new NotFoundException('Role not found');
        }

        // Check if role is currently active
        if (!roleDoc.isActive) {
            throw new BadRequestException('Role is already inactive');
        }

        // Check if user can manage this role
        const userRole = await this.roleService.findOneById(user.role);
        const canManage = await this.roleService.canManageRole(
            userRole.type,
            userRole.name,
            user.companyId,
            roleDoc
        );

        if (!canManage) {
            throw new ConflictException(
                'Insufficient permissions to deactivate this role'
            );
        }

        await this.roleService.inactive(roleDoc);

        return;
    }

    @RoleAdminActiveDoc()
    @Response('role.active')
    @Permission('role', 'can_update')
    @UseGuards(PermissionGuard)
    @UserProtected()
    @AuthJwtAccessProtected()
    @Patch('/update/:role/active')
    async active(
        @Param('role', RequestRequiredPipe) role: string,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>() userPayloadToken: any,
        @Req() request: Request
    ): Promise<void> {
        const user = (request as any).user;

        // Check if user is Tenant User or Company Admin and handle tenant-specific role activation
        const userType: ENUM_SHARED_USER_TYPE = userPayloadToken?.userType;
        const tenantId: string = userPayloadToken?.tenantId;

        if (
            userType &&
            (userType === ENUM_SHARED_USER_TYPE.TENANT_USER ||
                userType === ENUM_SHARED_USER_TYPE.COMPANY_ADMIN) &&
            tenantId
        ) {
            // Handle tenant-specific role activation
            const tenantConnection = null;
            // Perform activation within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId, connection: tenantConnection }, async () => {
                // Find the role in tenant database
                const tenantRole = await this.tenantRoleService.findOneById(role);
                if (!tenantRole) {
                    throw new NotFoundException(
                        'Role not found in tenant database'
                    );
                }

                // Check if role is currently inactive
                if (tenantRole.isActive) {
                    throw new BadRequestException('Role is already active');
                }

                // Update the role to active in tenant database
                await this.tenantRoleService.update(tenantRole, {
                    isActive: true,
                });
            });
        }

        // Original logic for non-tenant users
        const roleDoc: RoleDoc = await this.roleService.findOneById(role);
        if (!roleDoc) {
            throw new NotFoundException('Role not found');
        }

        // Check if role is currently inactive
        if (roleDoc.isActive) {
            throw new BadRequestException('Role is already active');
        }

        // Check if user can manage this role
        const userRole = await this.roleService.findOneById(user.role);
        const canManage = await this.roleService.canManageRole(
            userRole.type,
            userRole.name,
            user.companyId,
            roleDoc
        );

        if (!canManage) {
            throw new ConflictException(
                'Insufficient permissions to activate this role'
            );
        }

        await this.roleService.active(roleDoc);

        return;
    }

    @RoleAdminDeleteDoc()
    @Response('role.delete')
    @Permission('role', 'can_delete')
    @UseGuards(PermissionGuard)
    @UserProtected()
    @AuthJwtAccessProtected()
    @Delete('/delete/:role')
    async delete(
        @Param('role', RequestRequiredPipe) role: string,
        @AuthJwtPayload<IAuthJwtAccessTokenPayload>() userPayloadToken: any,
        @Req() request: Request
    ): Promise<void> {
        const user = (request as any).user;

        // Check if user is Tenant User or Company Admin and handle tenant-specific role deletion
        const userType: ENUM_SHARED_USER_TYPE = userPayloadToken?.userType;
        const tenantId: string = userPayloadToken?.tenantId;

        if (
            userType &&
            (userType === ENUM_SHARED_USER_TYPE.TENANT_USER ||
                userType === ENUM_SHARED_USER_TYPE.COMPANY_ADMIN) &&
            tenantId
        ) {
            // Handle tenant-specific role deletion
            const tenantConnection = null;
            // Perform deletion within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId, connection: tenantConnection }, async () => {
                // Find the role in tenant database
                const tenantRole = await this.tenantRoleService.findOneById(role);
                if (!tenantRole) {
                    throw new NotFoundException(
                        'Role not found in tenant database'
                    );
                }

                // Check hierarchy for tenant role deletion
                const currentUserLevel = user.roleLevel || 1;
                const canManageTenantRole = this.tenantRoleService.validateTenantRoleHierarchy(currentUserLevel, tenantRole.level);

                if (!canManageTenantRole) {
                    throw new TenantRoleHierarchyInsufficientLevelException(
                        currentUserLevel,
                        tenantRole.level,
                        tenantId,
                        'delete'
                    );
                }

                // Check if tenant role is assigned to any users
                const isRoleInUse = await this.tenantRoleService.checkTenantRoleUsage(role);
                if (isRoleInUse) {
                    throw new RoleDeletionHasUsersException(tenantRole.name);
                }

                // Delete the role from tenant database
                await this.tenantRoleService.hardDelete(tenantRole);
            });
        }

        // Original logic for non-tenant users
        const roleDoc: RoleDoc = await this.roleService.findOneById(role);
        if (!roleDoc) {
            throw new NotFoundException('Role not found');
        }

        // Check hierarchy for role deletion
        const currentUserLevel = user.roleLevel || 1;
        const canManage = this.roleService.validateRoleHierarchy(currentUserLevel, roleDoc.level);

        if (!canManage) {
            throw new RoleHierarchyInsufficientLevelException(
                currentUserLevel,
                roleDoc.level,
                'delete'
            );
        }

        // Check if role is assigned to any users
        const isRoleInUse = await this.roleService.checkRoleUsage(role);
        if (isRoleInUse) {
            throw new RoleDeletionHasUsersException(roleDoc.name);
        }

        await this.roleService.delete(roleDoc);

        return;
    }
}
