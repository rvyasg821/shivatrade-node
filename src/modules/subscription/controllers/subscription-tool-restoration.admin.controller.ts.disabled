import { Controller, Get, Query, UseGuards, Post, Param } from '@nestjs/common';
import { ApiTags, ApiOperation, ApiResponse, ApiQuery, ApiParam } from '@nestjs/swagger';
import { AuthJwtAccessProtected } from '@modules/auth/decorators/auth.jwt.decorator';
import { Response } from '@common/response/decorators/response.decorator';
import { IResponse } from '@common/response/interfaces/response.interface';
import { PermissionGuard } from '@modules/role/guards/permission.guard';
import { Permission } from '@modules/role/decorators/permission.decorator';
import { SubscriptionToolRestorationService } from '../services/subscription-tool-restoration.service';
import { RestorationMetrics, RestorationAuditLog } from '../interfaces/restoration-metrics.interface';
import { RequestRequiredPipe } from '@common/request/pipes/request.required.pipe';

@ApiTags('modules.admin.subscription-tool-restoration')
@Controller({
    version: '1',
    path: '/subscription-tool-restoration',
})
export class SubscriptionToolRestorationAdminController {
    constructor(
        private readonly subscriptionToolRestorationService: SubscriptionToolRestorationService
    ) { }

    @ApiOperation({
        summary: 'Get restoration metrics',
        description: 'Retrieve metrics about tool restoration and transition operations',
    })
    @ApiResponse({
        status: 200,
        description: 'Restoration metrics retrieved successfully',
    })
    @Response('subscription-tool-restoration.metrics')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/metrics')
    async getMetrics(): Promise<IResponse<RestorationMetrics>> {
        const metrics = this.subscriptionToolRestorationService.getMetrics();

        return {
            data: metrics,
        };
    }

    @ApiOperation({
        summary: 'Get restoration audit logs',
        description: 'Retrieve recent restoration and transition operation audit logs',
    })
    @ApiQuery({
        name: 'limit',
        required: false,
        type: Number,
        description: 'Number of logs to retrieve (default: 100, max: 1000)',
    })
    @ApiResponse({
        status: 200,
        description: 'Audit logs retrieved successfully',
    })
    @Response('subscription-tool-restoration.auditLogs')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/audit-logs')
    async getAuditLogs(
        @Query('limit') limit?: number
    ): Promise<IResponse<RestorationAuditLog[]>> {
        const actualLimit = Math.min(limit || 100, 1000);
        const auditLogs = this.subscriptionToolRestorationService.getAuditLogs(actualLimit);

        return {
            data: auditLogs,
        };
    }

    @ApiOperation({
        summary: 'Get recent restoration failures',
        description: 'Retrieve restoration operations that failed in the specified time period',
    })
    @ApiQuery({
        name: 'hours',
        required: false,
        type: Number,
        description: 'Number of hours to look back (default: 24)',
    })
    @ApiResponse({
        status: 200,
        description: 'Recent failures retrieved successfully',
    })
    @Response('subscription-tool-restoration.recentFailures')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/recent-failures')
    async getRecentFailures(
        @Query('hours') hours?: number
    ): Promise<IResponse<RestorationAuditLog[]>> {
        const actualHours = hours || 24;
        const failures = this.subscriptionToolRestorationService.getRecentFailures(actualHours);

        return {
            data: failures,
        };
    }

    @ApiOperation({
        summary: 'Get restorations by trigger type',
        description: 'Retrieve restoration operations filtered by trigger type',
    })
    @ApiQuery({
        name: 'triggeredBy',
        required: true,
        enum: ['tool_provisioning', 'subscription_activation', 'subscription_creation', 'manual'],
        description: 'Filter by trigger type',
    })
    @ApiResponse({
        status: 200,
        description: 'Restorations by trigger retrieved successfully',
    })
    @Response('subscription-tool-restoration.byTrigger')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/by-trigger')
    async getRestorationsByTrigger(
        @Query('triggeredBy') triggeredBy: 'tool_provisioning' | 'subscription_activation' | 'subscription_creation' | 'manual'
    ): Promise<IResponse<RestorationAuditLog[]>> {
        const restorations = this.subscriptionToolRestorationService.getRestorationsByTrigger(triggeredBy);

        return {
            data: restorations,
        };
    }

    @ApiOperation({
        summary: 'Manually trigger tool restoration',
        description: 'Manually trigger tool restoration for a specific subscription',
    })
    @ApiParam({
        name: 'subscriptionId',
        required: true,
        description: 'Subscription ID to restore tools for',
    })
    @ApiResponse({
        status: 200,
        description: 'Tool restoration triggered successfully',
    })
    @Response('subscription-tool-restoration.manualRestore')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Post('/restore/:subscriptionId')
    async manualRestore(
        @Param('subscriptionId', RequestRequiredPipe) subscriptionId: string
    ): Promise<IResponse<any>> {
        const result = await this.subscriptionToolRestorationService.restoreSubscriptionToolsWithMetrics(
            subscriptionId,
            'manual'
        );

        return {
            data: result,
        };
    }

    @ApiOperation({
        summary: 'Manually trigger tool transition',
        description: 'Manually trigger tool transition between two subscriptions',
    })
    @ApiParam({
        name: 'oldSubscriptionId',
        required: true,
        description: 'Old subscription ID',
    })
    @ApiParam({
        name: 'newSubscriptionId',
        required: true,
        description: 'New subscription ID',
    })
    @ApiResponse({
        status: 200,
        description: 'Tool transition triggered successfully',
    })
    @Response('subscription-tool-restoration.manualTransition')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Post('/transition/:oldSubscriptionId/:newSubscriptionId')
    async manualTransition(
        @Param('oldSubscriptionId', RequestRequiredPipe) oldSubscriptionId: string,
        @Param('newSubscriptionId', RequestRequiredPipe) newSubscriptionId: string
    ): Promise<IResponse<any>> {
        const result = await this.subscriptionToolRestorationService.transitionToNewSubscriptionWithMetrics(
            oldSubscriptionId,
            newSubscriptionId,
            'manual'
        );

        return {
            data: result,
        };
    }
}