import {
    Body,
    Controller,
    Delete,
    Get,
    HttpCode,
    HttpStatus,
    Param,
    Patch,
    Post,
    Put,
    UseGuards,
    Query,
} from '@nestjs/common';
import { ApiQuery, ApiTags } from '@nestjs/swagger';
import { PaginationQuery } from '@common/pagination/decorators/pagination.decorator';
import { PaginationListDto } from '@common/pagination/dtos/pagination.list.dto';
import { PaginationService } from '@common/pagination/services/pagination.service';
import { RequestRequiredPipe } from '@common/request/pipes/request.required.pipe';
import {
    Response,
    ResponsePaging,
} from '@common/response/decorators/response.decorator';
import {
    IResponse,
    IResponsePaging,
} from '@common/response/interfaces/response.interface';
import { DatabaseIdResponseDto } from '@common/database/dtos/response/database.id.response.dto';
import { ENUM_PAGINATION_ORDER_DIRECTION_TYPE } from '@common/pagination/enums/pagination.enum';

import { SubscriptionService } from '../services/subscription.service';
import { ToolProvisioningService } from '../services/tool-provisioning.service';
import { SubscriptionCreateRequestDto } from '../dtos/request/subscription.create.request.dto';
import { SubscriptionUpdateRequestDto } from '../dtos/request/subscription.update.request.dto';
import { SubscriptionListResponseDto } from '../dtos/response/subscription.list.response.dto';
import { SubscriptionGetResponseDto } from '../dtos/response/subscription.get.response.dto';
import { SubscriptionDoc } from '../repository/entities/subscription.entity';
import {
    SubscriptionAdminListDoc,
    SubscriptionAdminGetDoc,
    SubscriptionAdminCreateDoc,
    SubscriptionAdminUpdateDoc,
    SubscriptionAdminUpdateStatusDoc,
    SubscriptionAdminDeleteDoc,
    SubscriptionAdminAnalyticsDoc,
    SubscriptionAdminCancelDoc,
    SubscriptionAdminListByCompanyDoc,
} from '../docs/subscription.admin.doc';
import {
    SubscriptionNotFoundException,
    SubscriptionAlreadyExistsException,
} from '../exceptions/subscription.exception';

import { AuthJwtAccessProtected, AuthJwtPayload } from '@modules/auth/decorators/auth.jwt.decorator';
import { Permission } from '@modules/role/decorators/permission.decorator';
import { PermissionGuard } from '@modules/role/guards/permission.guard';
import {
    SUBSCRIPTION_DEFAULT_AVAILABLE_ORDER_BY,
    SUBSCRIPTION_DEFAULT_AVAILABLE_SEARCH,
} from '../constants/subscription.list.constant';
import { SubscriptionParsePipe } from '../pipes';
import { Types } from 'mongoose';
import { NodemailerService } from '@modules/email/services/nodemailer.service';
import { ENUM_SYSTEM_ROLE } from '@modules/role/enums/role.enum';
import { UserService } from '@modules/user/services/user.service';

@ApiTags('modules.admin.subscription')
@Controller({
    version: '1',
    path: '/subscription',
})
export class SubscriptionAdminController {
    constructor(
        private readonly paginationService: PaginationService,
        private readonly subscriptionService: SubscriptionService,
        private readonly toolProvisioningService: ToolProvisioningService,
        private readonly nodemailerService: NodemailerService,
        private readonly userService: UserService
    ) { }

    @SubscriptionAdminListDoc()
    @ResponsePaging('subscription.list')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @ApiQuery({
        name: 'company_id',
        required: false,
    })
    @Get('/list')
    async list(
        @PaginationQuery({
            availableSearch: SUBSCRIPTION_DEFAULT_AVAILABLE_SEARCH,
            availableOrderBy: SUBSCRIPTION_DEFAULT_AVAILABLE_ORDER_BY,
        })
        { _search, _limit, _offset, _order }: PaginationListDto,
        @AuthJwtPayload('roleName') roleName: string,
        @AuthJwtPayload('user') CurrentuserId: string,
        @Query('user_id') userId?: string,
        @Query('status') status?: string,
        @Query('company_id') companyId?: string,
    ): Promise<IResponsePaging<SubscriptionListResponseDto>> {
        const find: Record<string, any> = {
            ..._search,
        };
        
        if(roleName === ENUM_SYSTEM_ROLE.AGENT) {
            const agent = await this.userService.findOneById(CurrentuserId?.toString());
            if(agent){
                find['$or'] = [
                    { referal_code: agent.referal_code },
                    { agent_id: agent._id }
                ];
            }else{
                find['agent_id'] = new Types.ObjectId(CurrentuserId?.toString());
            }
        }

        if (userId) {
            find.user_id = new Types.ObjectId(userId);
        }

        if (status !== undefined && status !== null && status !== '') {
            find.status = status === '1' || status === 'true';
        }

        if (companyId) {
            find.company_id = new Types.ObjectId(companyId);
        }

        const subscriptions: any[] =
            await this.subscriptionService.findAllWithJoins(find, {
                paging: {
                    limit: _limit,
                    offset: _offset,
                },
                order: _order,
            });

        const total: number = await this.subscriptionService.getTotal(find);
        const totalPage: number = this.paginationService.totalPage(
            total,
            _limit
        );

        const mapped: SubscriptionListResponseDto[] =
            this.subscriptionService.mapListWithJoins(subscriptions);

        return {
            _pagination: { total, totalPage },
            data: mapped,
        };
    }

    @SubscriptionAdminGetDoc()
    @Response('subscription.get')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/:subscription')
    async get(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse<SubscriptionGetResponseDto>> {
        const subscriptionWithJoins =
            await this.subscriptionService.findOneWithJoins(subscription._id.toString());

        let mapped: SubscriptionGetResponseDto;
        if (subscriptionWithJoins) {
            mapped = await this.subscriptionService.mapGetWithJoins(
                subscriptionWithJoins
            );
        } else {
            // Fallback to original subscription if join failed
            mapped = await this.subscriptionService.mapGetWithJoins(subscription);
        }

        return { data: mapped };
    }

    @SubscriptionAdminCreateDoc()
    @Response('subscription.create')
    @HttpCode(HttpStatus.CREATED)
    @Permission('subscription', 'can_add')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Post('/create')
    async create(
        @Body() body: SubscriptionCreateRequestDto
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        // Check if user already has an active subscription
        const existingSubscription =
            await this.subscriptionService.findActiveByUserId(body.user_id);
        if (existingSubscription) {
            throw new SubscriptionAlreadyExistsException(body.user_id);
        }

        const created: SubscriptionDoc =
            await this.subscriptionService.create(body);

        return {
            data: { _id: created._id.toString() },
        };
    }

    @SubscriptionAdminUpdateDoc()
    @Response('subscription.update')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Put('/:subscription')
    async update(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc,
        @Body() body: SubscriptionUpdateRequestDto
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        const updated: SubscriptionDoc = await this.subscriptionService.update(
            subscription,
            body
        );

        return {
            data: { _id: updated._id.toString() },
        };
    }

    @SubscriptionAdminUpdateStatusDoc()
    @Response('subscription.updateStatus')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Patch('/:subscription/status')
    async updateStatus(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc,
        @Body() body: { status: boolean }
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        const updated: SubscriptionDoc =
            await this.subscriptionService.updateStatus(
                subscription,
                body.status
            );

        return {
            data: { _id: updated._id.toString() },
        };
    }

    @SubscriptionAdminCancelDoc()
    @Response('subscription.cancel')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Patch('/:subscription/cancel')
    async cancel(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        const cancelled: SubscriptionDoc =
            await this.subscriptionService.updateStatus(subscription, false);

        return {
            data: { _id: cancelled._id.toString() },
        };
    }

    @SubscriptionAdminDeleteDoc()
    @Response('subscription.delete')
    @Permission('subscription', 'can_delete')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Delete('/:subscription')
    async delete(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse<DatabaseIdResponseDto>> {
        await this.subscriptionService.softDelete(subscription);

        return {
            data: { _id: subscription._id.toString() },
        };
    }

    @SubscriptionAdminAnalyticsDoc()
    @ResponsePaging('subscription.analytics')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/analytics/overview')
    async analyticsOverview(): Promise<IResponse<Record<string, any>>> {
        const totalSubscriptions = await this.subscriptionService.getTotal();
        const activeSubscriptions =
            await this.subscriptionService.countByStatus(true);
        const inactiveSubscriptions =
            await this.subscriptionService.countByStatus(false);
        const trialSubscriptions =
            await this.subscriptionService.findTrialSubscriptions();
        const lifetimeSubscriptions =
            await this.subscriptionService.findLifetimeSubscriptions();

        return {
            data: {
                total: totalSubscriptions,
                active: activeSubscriptions,
                inactive: inactiveSubscriptions,
                trial: trialSubscriptions.length,
                lifetime: lifetimeSubscriptions.length,
            },
        };
    }

    @Response('subscription.provision')
    @HttpCode(HttpStatus.OK)
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Post('/:subscription/provision')
    async provisionTools(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse> {
        const result =
            await this.toolProvisioningService.provisionToolsForSubscription(
                subscription
            );

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: result,
        } as any;
    }

    @Response('subscription.provisions.validate')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/:subscription/provision/validate')
    async validateProvisioning(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse> {
        const isValid =
            await this.toolProvisioningService.validateToolProvisioning(
                subscription
            );

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: { isValid },
        } as any;
    }

    @Response('subscription.provisions.rollback')
    @HttpCode(HttpStatus.OK)
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Post('/:subscription/provision/rollback')
    async rollbackProvisioning(
        @Param('subscription', RequestRequiredPipe, SubscriptionParsePipe)
        subscription: SubscriptionDoc
    ): Promise<IResponse> {
        await this.toolProvisioningService.rollbackToolProvisioning(
            subscription
        );

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: { message: 'Provisioning rolled back successfully' },
        } as any;
    }

    @Get('/provisioning/status/:status')
    @Response('subscription.provisioning.status')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    async getSubscriptionsByProvisioningStatus(
        @Param('status')
        status: 'pending' | 'provisioning' | 'provisioned' | 'failed'
    ): Promise<IResponse> {
        const subscriptions =
            await this.subscriptionService.findSubscriptionsByProvisioningStatus(
                status
            );
        const mapped = this.subscriptionService.mapList(subscriptions);

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: mapped,
        } as any;
    }

    @Get('/provisioning/failed')
    @Response('subscription.provisioning.failed')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    async getFailedProvisioningSubscriptions(): Promise<IResponse> {
        const subscriptions =
            await this.subscriptionService.findFailedProvisioningSubscriptions();
        const mapped = this.subscriptionService.mapList(subscriptions);

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: mapped,
        } as any;
    }

    @SubscriptionAdminListByCompanyDoc()
    @ResponsePaging('subscription.listByCompany')
    @Permission('subscription', 'can_read')
    @UseGuards(PermissionGuard)
    @AuthJwtAccessProtected()
    @Get('/company/:companyId')
    async getSubscriptionsByCompanyId(
        @Param('companyId', RequestRequiredPipe) companyId: string,
        @PaginationQuery({
            availableSearch: ["plan_type","provisioningStatus"],
        })
        { _search, _limit, _offset, _order }: PaginationListDto
    ): Promise<IResponsePaging<SubscriptionListResponseDto>> {
        const find: Record<string, any> = {
            ..._search,
            company_id: new Types.ObjectId(companyId),
        };

        const subscriptions: any[] =
            await this.subscriptionService.findAllWithJoins(find, {
                paging: {
                    limit: 100,
                    offset: _offset,
                },
                order: _order,
            });

        const total: number = await this.subscriptionService.getTotal(find);
        const totalPage: number = this.paginationService.totalPage(
            total,
            _limit
        );

        const mapped: SubscriptionListResponseDto[] =
            this.subscriptionService.mapListWithJoins(subscriptions);

        return {
            _pagination: { total, totalPage },
            data: mapped,
        };
    }

    @Post('/provisioning/retry/:id')
    @HttpCode(HttpStatus.OK)
    @Response('subscription.provisioning.retry')
    @Permission('subscription', 'can_update')
    @UseGuards(PermissionGuard)
    async retryProvisioning(
        @Param('id', RequestRequiredPipe) id: string
    ): Promise<IResponse> {
        await this.subscriptionService.retryProvisioningForSubscription(id);

        return {
            _metadata: {
                languages: [],
                timestamp: Date.now(),
            },
            data: { message: 'Provisioning retry initiated successfully' },
        } as any;
    }

}
