import { Injectable, Logger } from '@nestjs/common';
import { SubscriptionToolLoggerService } from '@common/logger/services/subscription-tool-logger.service';
import { Types } from 'mongoose';
import { SubscriptionRepository } from '../repository/repositories/subscription.repository';
import { CompanyRepository } from '@modules/company/repository/repositories/company.repository';
import { ISelectedTool } from '../repository/entities/subscription.entity';
import { RestorationMetrics, RestorationAuditLog } from '../interfaces/restoration-metrics.interface';
import { ToolsService } from '@modules/tools/services/tools.service';
export interface RestorationResult {
    success: boolean;
    toolsRestored: number;
    settingsRestored: number;
    cronRestored: number;
    message: string;
    error?: string;
}

export interface TransitionResult {
    success: boolean;
    oldToolsDeactivated: number;
    newToolsCreated: number;
    settingsCreated: number;
    cronCreated: number;
    message: string;
    error?: string;
}

@Injectable()
export class SubscriptionToolRestorationService {
    private readonly logger = new Logger(SubscriptionToolRestorationService.name);
    private metrics: RestorationMetrics = {
        totalRestorationAttempts: 0,
        successfulRestorations: 0,
        failedRestorations: 0,
        totalToolsRestored: 0,
        totalSettingsRestored: 0,
        totalCronRestored: 0,
        totalTransitions: 0,
        successfulTransitions: 0,
        failedTransitions: 0,
        averageRestorationTime: 0,
        averageTransitionTime: 0,
        lastRestorationTimestamp: new Date(),
        lastTransitionTimestamp: new Date(),
    };
    private auditLogs: RestorationAuditLog[] = [];

    constructor(
        private readonly subscriptionRepository: SubscriptionRepository,
        private readonly toolsService: ToolsService,
        private readonly companyRepository: CompanyRepository,private readonly tenantToolSettingsRepository: TenantToolSettingsRepository,
        private readonly tenantToolSettingCronRepository: TenantToolSettingCronRepository,
        private readonly subscriptionToolLogger: SubscriptionToolLoggerService,) { }

    async restoreSubscriptionTools(subscriptionId: string): Promise<RestorationResult> {
        try {
            this.subscriptionToolLogger.logToolRestoration(`Starting tool restoration for subscription: ${subscriptionId}`, 'SubscriptionToolRestorationService');

            // Validate subscription
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
            if (!subscription) {
                const error = `Subscription not found: ${subscriptionId}`;
                this.logger.error(error);
                return {
                    success: false,
                    toolsRestored: 0,
                    settingsRestored: 0,
                    cronRestored: 0,
                    message: 'Restoration failed - subscription not found',
                    error
                };
            }

            // Validate subscription has tools
            if (!subscription.tools || subscription.tools.length === 0) {
                this.logger.log(`No tools found in subscription ${subscriptionId}, skipping restoration`);
                return {
                    success: true,
                    toolsRestored: 0,
                    settingsRestored: 0,
                    cronRestored: 0,
                    message: 'No tools to restore'
                };
            }

            // Extract tool IDs from subscription
            const subscriptionToolIds = subscription.tools.map(tool => tool._id.toString());
            this.logger.log(`Found ${subscriptionToolIds.length} tools in subscription: ${subscriptionToolIds.join(', ')}`);

            // Restore tools selectively based on subscription tools
            const restorationResult = await this.restoreToolsSelectively(
                subscriptionId,
                subscription.company_id.toString(),
                subscriptionToolIds
            );

            this.logger.log(`Tool restoration completed for subscription ${subscriptionId}: Tools: ${restorationResult.toolsRestored}, Settings: ${restorationResult.settingsRestored}, Cron: ${restorationResult.cronRestored}`);

            return restorationResult;

        } catch (error) {
            this.logger.error(`Error during tool restoration for subscription ${subscriptionId}: ${error.message}`, error.stack);
            return {
                success: false,
                toolsRestored: 0,
                settingsRestored: 0,
                cronRestored: 0,
                message: 'Tool restoration failed due to unexpected error',
                error: error.message
            };
        }
    }

    async transitionToNewSubscription(oldSubscriptionId: string, newSubscriptionId: string): Promise<TransitionResult> {
        try {
            this.logger.log(`Starting tool transition from subscription ${oldSubscriptionId} to ${newSubscriptionId}`);

            // Validate both subscriptions
            const [oldSubscription, newSubscription] = await Promise.all([
                this.subscriptionRepository.findOneById(oldSubscriptionId),
                this.subscriptionRepository.findOneById(newSubscriptionId)
            ]);

            if (!oldSubscription) {
                const error = `Old subscription not found: ${oldSubscriptionId}`;
                this.logger.error(error);
                return {
                    success: false,
                    oldToolsDeactivated: 0,
                    newToolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0,
                    message: 'Transition failed - old subscription not found',
                    error
                };
            }

            if (!newSubscription) {
                const error = `New subscription not found: ${newSubscriptionId}`;
                this.logger.error(error);
                return {
                    success: false,
                    oldToolsDeactivated: 0,
                    newToolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0,
                    message: 'Transition failed - new subscription not found',
                    error
                };
            }

            // Validate subscriptions belong to same company
            if (oldSubscription.company_id.toString() !== newSubscription.company_id.toString()) {
                const error = `Subscriptions belong to different companies`;
                this.logger.error(error);
                return {
                    success: false,
                    oldToolsDeactivated: 0,
                    newToolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0,
                    message: 'Transition failed - subscriptions belong to different companies',
                    error
                };
            }

            // Step 1: Deactivate all old tools for the company
            const deactivationResult = await this.deactivateAllCompanyTools(oldSubscription.company_id.toString());

            // Step 2: Create new tools based on new subscription
            const creationResult = await this.createNewSubscriptionTools(newSubscriptionId);

            const result: TransitionResult = {
                success: deactivationResult.success && creationResult.success,
                oldToolsDeactivated: deactivationResult.toolsDeactivated,
                newToolsCreated: creationResult.toolsCreated,
                settingsCreated: creationResult.settingsCreated,
                cronCreated: creationResult.cronCreated,
                message: `Transition completed: ${deactivationResult.toolsDeactivated} old tools deactivated, ${creationResult.toolsCreated} new tools created`,
                error: deactivationResult.error || creationResult.error
            };

            this.logger.log(`Tool transition completed: ${result.message}`);
            return result;

        } catch (error) {
            this.logger.error(`Error during tool transition: ${error.message}`, error.stack);
            return {
                success: false,
                oldToolsDeactivated: 0,
                newToolsCreated: 0,
                settingsCreated: 0,
                cronCreated: 0,
                message: 'Tool transition failed due to unexpected error',
                error: error.message
            };
        }
    }

    async validateToolConfiguration(subscriptionId: string): Promise<boolean> {
        try {
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);

            if (!subscription) {
                this.logger.error(`Subscription not found for validation: ${subscriptionId}`);
                return false;
            }

            // Validate subscription has valid tool configuration
            if (!subscription.tools || !Array.isArray(subscription.tools)) {
                this.logger.error(`Invalid tools configuration in subscription: ${subscriptionId}`);
                return false;
            }

            // Validate each tool has required fields
            for (const tool of subscription.tools) {
                if (!tool._id || !tool.name) {
                    this.logger.error(`Invalid tool configuration in subscription ${subscriptionId}: missing _id or name`);
                    return false;
                }

                // Validate tool ID format
                if (!Types.ObjectId.isValid(tool._id)) {
                    this.logger.error(`Invalid tool ID format in subscription ${subscriptionId}: ${tool._id}`);
                    return false;
                }
            }

            // Validate company context
            const company = await this.companyRepository.findOneById(subscription.company_id.toString());
            if (!company) {
                this.logger.error(`Company not found for subscription ${subscriptionId}: ${subscription.company_id}`);
                return false;
            }

            if (!company.tenantId) {
                this.logger.error(`TenantId not found for company ${company._id} in subscription ${subscriptionId}`);
                return false;
            }

            return true;

        } catch (error) {
            this.logger.error(`Error validating tool configuration for subscription ${subscriptionId}: ${error.message}`);
            return false;
        }
    }

    private async restoreToolsSelectively(
        subscriptionId: string,
        companyId: string,
        toolIds: string[]
    ): Promise<RestorationResult> {
        try {
            let toolsRestored = 0;
            let settingsRestored = 0;
            let cronRestored = 0;

            // Get company to set up tenant connection
            const company = await this.companyRepository.findOneById(companyId);
            if (!company || !company.tenantId) {
                throw new Error(`Company or tenantId not found: ${companyId}`);
            }

            // Set up tenant connection
            // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

            // Perform restoration within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
                // Initialize repository with tenant connection
                this.tenantToolSettingsRepository.setConnection(tenantConnection);

                // Since tools are now in master collection, we restore settings by toolId and subscriptionId
                // Find tenant tool settings that match the subscription tools
                const tenantToolSettings = await this.tenantToolSettingsRepository.findAll({
                    subscriptionId: new Types.ObjectId(subscriptionId),
                    toolId: { $in: toolIds.map(id => new Types.ObjectId(id)) }
                });

                this.logger.log(`Found ${tenantToolSettings.length} tenant tool settings to restore for subscription ${subscriptionId}`);

                if (tenantToolSettings.length === 0) {
                    console.log('No matching tenant tool settings found to restore');
                    return {
                        success: true,
                        toolsRestored: 0,
                        settingsRestored: 0,
                        cronRestored: 0,
                        message: 'No matching tenant tool settings found to restore'
                    };
                }

                // Restore tenant tool settings by setting soft_delete to false
                const settingIds = tenantToolSettings.map(setting => setting._id.toString());
                const settingsResult = await this.restoreTenantToolSettingsBulk(settingIds);
                let settingsRestored = settingsResult.modifiedCount;

                // Restore tenant tool cron entries
                let cronRestored = 0;
                if (settingIds.length > 0) {
                    const cronResult = await this.restoreTenantToolCronBulk(settingIds);
                    cronRestored = cronResult.modifiedCount;
                }

                // Tools are in master collection, not restored from tenant database
                let toolsRestored = 0;

                this.logger.log(`Selective restoration completed: Settings: ${settingsRestored}, Cron: ${cronRestored} (tools managed in master collection)`);

                return {
                    success: true,
                    toolsRestored: 0, // Tools are in master collection
                    settingsRestored,
                    cronRestored,
                    message: `Successfully restored ${settingsRestored} settings and ${cronRestored} cron entries (tools managed in master collection)`
                };
            });

        } catch (error) {
            this.logger.error(`Error during selective tool restoration: ${error.message}`, error.stack);
            return {
                success: false,
                toolsRestored: 0,
                settingsRestored: 0,
                cronRestored: 0,
                message: 'Selective restoration failed',
                error: error.message
            };
        }
    }

    private async restoreTenantToolSettingsBulk(settingIds: string[]): Promise<{ modifiedCount: number }> {
        const objectIds = settingIds.map(id => new Types.ObjectId(id));
        return this.tenantToolSettingsRepository.updateMany(
            {
                _id: { $in: objectIds },
                soft_delete: true
            },
            {
                soft_delete: false,
                deletedAt: null
            }
        );
    }

    private async restoreTenantToolCronBulk(tenantToolSettingIds: string[]): Promise<{ modifiedCount: number }> {
        const objectIds = tenantToolSettingIds.map(id => new Types.ObjectId(id));
        return this.tenantToolSettingCronRepository.updateMany(
            {
                tenantToolSettingId: { $in: objectIds },
                soft_delete: true
            },
            {
                soft_delete: false,
                deletedAt: null
            }
        );
    }

    private async deactivateAllCompanyTools(companyId: string): Promise<{ success: boolean; toolsDeactivated: number; error?: string }> {
        try {
            this.logger.log(`Deactivating all tools for company: ${companyId}`);

            // Find company to get tenantId
            const company = await this.companyRepository.findOneById(companyId);
            if (!company || !company.tenantId) {
                const error = `Company or tenantId not found: ${companyId}`;
                this.logger.error(error);
                return {
                    success: false,
                    toolsDeactivated: 0,
                    error
                };
            }

            // Set up tenant connection
            // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

            // Perform deactivation within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
                // Find all active tenant tool settings for this company (across all subscriptions)
                const allSettings = await this.tenantToolSettingsRepository.findAll({});

                if (allSettings.length === 0) {
                    this.logger.log(`No tenant tool settings found for company ${companyId}`);
                    return {
                        success: true,
                        toolsDeactivated: 0
                    };
                }

                const settingIds = allSettings.map(setting => setting._id.toString());

                // Soft delete all tenant tool settings
                const settingsResult = await this.softDeleteTenantToolSettingsBulk(settingIds);

                // Soft delete all related cron entries
                if (settingIds.length > 0) {
                    await this.softDeleteTenantToolCronBulk(settingIds);
                }

                this.logger.log(`Deactivated ${settingsResult.modifiedCount} settings for company ${companyId}`);

                return {
                    success: true,
                    toolsDeactivated: 0 // Tools are in master collection
                };
            });

        } catch (error) {
            this.logger.error(`Error deactivating company tools: ${error.message}`, error.stack);
            return {
                success: false,
                toolsDeactivated: 0,
                error: error.message
            };
        }
    }

    private async createNewSubscriptionTools(subscriptionId: string): Promise<{ success: boolean; toolsCreated: number; settingsCreated: number; cronCreated: number; error?: string }> {
        try {
            this.logger.log(`Creating new tools for subscription: ${subscriptionId}`);

            // Get subscription details
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
            if (!subscription) {
                const error = `Subscription not found: ${subscriptionId}`;
                this.logger.error(error);
                return {
                    success: false,
                    toolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0,
                    error
                };
            }

            // Get company details for tenantId
            const company = await this.companyRepository.findOneById(subscription.company_id.toString());
            if (!company || !company.tenantId) {
                const error = `Company or tenantId not found for subscription: ${subscriptionId}`;
                this.logger.error(error);
                return {
                    success: false,
                    toolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0,
                    error
                };
            }

            // Check if subscription has tools
            if (!subscription.tools || subscription.tools.length === 0) {
                this.logger.log(`No tools found in subscription ${subscriptionId}`);
                return {
                    success: true,
                    toolsCreated: 0,
                    settingsCreated: 0,
                    cronCreated: 0
                };
            }

            // Set up tenant connection
            // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

            // Perform creation within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
                // Extract tool IDs from subscription
                const toolIds = subscription.tools.map(tool => tool?._id?.toString());

                // Count settings before creation
                const settingsBefore = await this.tenantToolSettingsRepository.countDocuments({});

                // Create settings for each tool in the subscription
                // Note: Tools are now in master collection, we only create settings
                let settingsCreated = 0;
                let cronCreated = 0;

                for (const toolId of toolIds) {
                    const tool = await this.toolsService.findOneById(toolId);
                    if (tool) {
                        // Create a basic setting for this tool
                        const setting = await this.tenantToolSettingsRepository.create({
                            toolId: new Types.ObjectId(toolId),
                            subscriptionId: new Types.ObjectId(subscriptionId),
                            status: 1,
                            soft_delete: false
                        });
                        settingsCreated++;

                        // Get tool configuration to retrieve settings and cron schedules
                        const toolConfig = await this.toolsDataService.getToolConfigByToolId(toolId);
                        if (toolConfig && toolConfig.settings) {
                            // Extract all cron schedules from all settings
                            const allCronConfigs = toolConfig.settings.flatMap(s =>
                                s.cron_schedules || []
                            );

                            // Create cron schedules for this tool setting
                            if (allCronConfigs.length > 0) {
                                this.logger.log(
                                    `Creating ${allCronConfigs.length} cron schedules for tool ${tool.name} (setting: ${setting._id})`
                                );
                                await this.tenantToolSettingCronService.createCronSchedulesForSetting(
                                    setting._id.toString(),
                                    allCronConfigs
                                );
                                cronCreated += allCronConfigs.length;
                            }
                        }
                    }
                }

                // Count settings after creation
                const settingsAfter = await this.tenantToolSettingsRepository.countDocuments({});
                settingsCreated = settingsAfter - settingsBefore;

                this.logger.log(`Created ${settingsCreated} settings for subscription ${subscriptionId} (tools managed in master collection)`);

                return {
                    success: true,
                    toolsCreated: 0, // Tools are in master collection
                    settingsCreated,
                    cronCreated
                };
            });

        } catch (error) {
            this.logger.error(`Error creating new subscription tools: ${error.message}`, error.stack);
            return {
                success: false,
                toolsCreated: 0,
                settingsCreated: 0,
                cronCreated: 0,
                error: error.message
            };
        }
    }

    private async softDeleteTenantToolSettingsBulk(settingIds: string[]): Promise<{ modifiedCount: number }> {
        const objectIds = settingIds.map(id => new Types.ObjectId(id));
        return this.tenantToolSettingsRepository.updateMany(
            {
                _id: { $in: objectIds },
                soft_delete: false
            },
            {
                soft_delete: true,
                deletedAt: new Date()
            }
        );
    }

    private async softDeleteTenantToolCronBulk(tenantToolSettingIds: string[]): Promise<{ modifiedCount: number }> {
        const objectIds = tenantToolSettingIds.map(id => new Types.ObjectId(id));
        return this.tenantToolSettingCronRepository.updateMany(
            {
                tenantToolSettingId: { $in: objectIds },
                soft_delete: false
            },
            {
                soft_delete: true,
                deletedAt: new Date()
            }
        );
    }

    async validateSubscriptionOwnership(subscriptionId: string, companyId: string): Promise<boolean> {
        try {
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);

            if (!subscription) {
                this.logger.error(`Subscription not found for ownership validation: ${subscriptionId}`);
                return false;
            }

            if (subscription.company_id.toString() !== companyId) {
                this.logger.error(`Subscription ${subscriptionId} does not belong to company ${companyId}`);
                return false;
            }

            return true;

        } catch (error) {
            this.logger.error(`Error validating subscription ownership: ${error.message}`);
            return false;
        }
    }

    async findMatchingTenantTools(subscriptionId: string, toolIds: string[]): Promise<any[]> {
        try {
            // Get subscription to find company and set up tenant connection
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
            if (!subscription) {
                this.logger.error(`Subscription not found: ${subscriptionId}`);
                return [];
            }

            const company = await this.companyRepository.findOneById(subscription.company_id.toString());
            if (!company || !company.tenantId) {
                this.logger.error(`Company or tenantId not found for subscription: ${subscriptionId}`);
                return [];
            }

            // Set up tenant connection
            // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

            // Find settings within tenant context
            // Tenant service removed: return await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
                // Find tenant tool settings that match the subscription tools
                // Tools are now in master collection, we match by toolId
                const tenantToolSettings = await this.tenantToolSettingsRepository.findAll({
                    subscriptionId: new Types.ObjectId(subscriptionId),
                    toolId: { $in: toolIds.map(id => new Types.ObjectId(id)) }
                });

                this.logger.log(`Found ${tenantToolSettings.length} matching tenant tool settings for subscription ${subscriptionId}`);
                return tenantToolSettings;
            });

        } catch (error) {
            this.logger.error(`Error finding matching tenant tools: ${error.message}`);
            return [];
        }
    }

    async validateToolMatchingCriteria(subscriptionId: string): Promise<{ isValid: boolean; message: string }> {
        try {
            // Validate subscription exists and has tools
            const isValidConfig = await this.validateToolConfiguration(subscriptionId);
            if (!isValidConfig) {
                return {
                    isValid: false,
                    message: 'Invalid tool configuration in subscription'
                };
            }

            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
            const toolIds = subscription.tools.map(tool => tool._id.toString());

            // Check if there are any matching tenant tool settings
            const matchingSettings = await this.findMatchingTenantTools(subscriptionId, toolIds);

            if (matchingSettings.length === 0) {
                return {
                    isValid: false,
                    message: 'No matching tenant tool settings found for subscription tools'
                };
            }

            // Validate that all matching settings belong to the correct subscription
            const invalidSettings = matchingSettings.filter(setting =>
                setting.subscriptionId?.toString() !== subscriptionId
            );

            if (invalidSettings.length > 0) {
                return {
                    isValid: false,
                    message: `Found ${invalidSettings.length} settings that don't belong to the subscription`
                };
            }

            return {
                isValid: true,
                message: `Found ${matchingSettings.length} valid matching settings`
            };

        } catch (error) {
            this.logger.error(`Error validating tool matching criteria: ${error.message}`);
            return {
                isValid: false,
                message: `Validation error: ${error.message}`
            };
        }
    }

    // Metrics and Audit Logging Methods
    private recordRestorationAttempt(
        subscriptionId: string,
        companyId: string,
        result: RestorationResult,
        executionTimeMs: number,
        triggeredBy: RestorationAuditLog['triggeredBy'] = 'manual'
    ): void {
        // Update metrics
        this.metrics.totalRestorationAttempts++;
        this.metrics.lastRestorationTimestamp = new Date();

        if (result.success) {
            this.metrics.successfulRestorations++;
            this.metrics.totalToolsRestored += result.toolsRestored;
            this.metrics.totalSettingsRestored += result.settingsRestored;
            this.metrics.totalCronRestored += result.cronRestored;
        } else {
            this.metrics.failedRestorations++;
        }

        // Calculate average restoration time
        this.metrics.averageRestorationTime =
            (this.metrics.averageRestorationTime * (this.metrics.totalRestorationAttempts - 1) + executionTimeMs) /
            this.metrics.totalRestorationAttempts;

        // Create audit log entry
        const auditLog: RestorationAuditLog = {
            subscriptionId,
            companyId,
            timestamp: new Date(),
            operation: 'restoration',
            success: result.success,
            toolsRestored: result.toolsRestored,
            settingsRestored: result.settingsRestored,
            cronRestored: result.cronRestored,
            executionTimeMs,
            error: result.error,
            triggeredBy,
        };

        // Keep only last 1000 audit logs to prevent memory issues
        this.auditLogs.push(auditLog);
        if (this.auditLogs.length > 1000) {
            this.auditLogs.shift();
        }

        // Log metrics for monitoring
        this.logger.log(
            `Restoration metrics - Attempts: ${this.metrics.totalRestorationAttempts}, ` +
            `Success: ${this.metrics.successfulRestorations}, ` +
            `Failed: ${this.metrics.failedRestorations}, ` +
            `Avg Time: ${this.metrics.averageRestorationTime.toFixed(2)}ms`
        );
    }

    private recordTransitionAttempt(
        oldSubscriptionId: string,
        newSubscriptionId: string,
        result: TransitionResult,
        executionTimeMs: number,
        triggeredBy: RestorationAuditLog['triggeredBy'] = 'manual'
    ): void {
        // Update metrics
        this.metrics.totalTransitions++;
        this.metrics.lastTransitionTimestamp = new Date();

        if (result.success) {
            this.metrics.successfulTransitions++;
        } else {
            this.metrics.failedTransitions++;
        }

        // Calculate average transition time
        this.metrics.averageTransitionTime =
            (this.metrics.averageTransitionTime * (this.metrics.totalTransitions - 1) + executionTimeMs) /
            this.metrics.totalTransitions;

        // Create audit log entry
        const auditLog: RestorationAuditLog = {
            subscriptionId: newSubscriptionId,
            timestamp: new Date(),
            operation: 'transition',
            success: result.success,
            oldToolsDeactivated: result.oldToolsDeactivated,
            newToolsCreated: result.newToolsCreated,
            settingsCreated: result.settingsCreated,
            cronCreated: result.cronCreated,
            executionTimeMs,
            error: result.error,
            triggeredBy,
            details: {
                oldSubscriptionId,
                newSubscriptionId,
            },
        };

        // Keep only last 1000 audit logs to prevent memory issues
        this.auditLogs.push(auditLog);
        if (this.auditLogs.length > 1000) {
            this.auditLogs.shift();
        }

        // Log metrics for monitoring
        this.logger.log(
            `Transition metrics - Attempts: ${this.metrics.totalTransitions}, ` +
            `Success: ${this.metrics.successfulTransitions}, ` +
            `Failed: ${this.metrics.failedTransitions}, ` +
            `Avg Time: ${this.metrics.averageTransitionTime.toFixed(2)}ms`
        );
    }

    getMetrics(): RestorationMetrics {
        return { ...this.metrics };
    }

    getAuditLogs(limit: number = 100): RestorationAuditLog[] {
        return this.auditLogs.slice(-limit);
    }

    getRecentFailures(hours: number = 24): RestorationAuditLog[] {
        const cutoffTime = new Date(Date.now() - hours * 60 * 60 * 1000);
        return this.auditLogs.filter(log =>
            !log.success && log.timestamp >= cutoffTime
        );
    }

    getRestorationsByTrigger(triggeredBy: RestorationAuditLog['triggeredBy']): RestorationAuditLog[] {
        return this.auditLogs.filter(log => log.triggeredBy === triggeredBy);
    }

    async restoreSubscriptionToolsWithMetrics(
        subscriptionId: string,
        triggeredBy: RestorationAuditLog['triggeredBy'] = 'manual'
    ): Promise<RestorationResult> {
        const startTime = Date.now();

        try {
            const result = await this.restoreSubscriptionTools(subscriptionId);
            const executionTime = Date.now() - startTime;

            // Get company ID for audit logging
            const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
            const companyId = subscription?.company_id?.toString() || 'unknown';

            this.recordRestorationAttempt(subscriptionId, companyId, result, executionTime, triggeredBy);

            return result;
        } catch (error) {
            const executionTime = Date.now() - startTime;
            const errorResult: RestorationResult = {
                success: false,
                toolsRestored: 0,
                settingsRestored: 0,
                cronRestored: 0,
                message: 'Restoration failed with exception',
                error: error.message
            };

            // Get company ID for audit logging
            try {
                const subscription = await this.subscriptionRepository.findOneById(subscriptionId);
                const companyId = subscription?.company_id?.toString() || 'unknown';
                this.recordRestorationAttempt(subscriptionId, companyId, errorResult, executionTime, triggeredBy);
            } catch (auditError) {
                this.logger.error(`Failed to record restoration audit log: ${auditError.message}`);
            }

            return errorResult;
        }
    }

    async transitionToNewSubscriptionWithMetrics(
        oldSubscriptionId: string,
        newSubscriptionId: string,
        triggeredBy: RestorationAuditLog['triggeredBy'] = 'manual'
    ): Promise<TransitionResult> {
        const startTime = Date.now();

        try {
            const result = await this.transitionToNewSubscription(oldSubscriptionId, newSubscriptionId);
            const executionTime = Date.now() - startTime;

            this.recordTransitionAttempt(oldSubscriptionId, newSubscriptionId, result, executionTime, triggeredBy);

            return result;
        } catch (error) {
            const executionTime = Date.now() - startTime;
            const errorResult: TransitionResult = {
                success: false,
                oldToolsDeactivated: 0,
                newToolsCreated: 0,
                settingsCreated: 0,
                cronCreated: 0,
                message: 'Transition failed with exception',
                error: error.message
            };

            this.recordTransitionAttempt(oldSubscriptionId, newSubscriptionId, errorResult, executionTime, triggeredBy);

            return errorResult;
        }
    }

    /**
     * Handle subscription purchase by updating existing tools or creating new ones
     * This method should be called with subscription tools (with originalToolId)
     */
    async handleSubscriptionPurchaseWithToolIds(
        subscriptionId: string,
        companyId: string,
        subscriptionTools: Array<{ _id: string; name: string }>
    ): Promise<{
        success: boolean;
        toolsUpdated: number;
        toolsCreated: number;
        message: string;
        error?: string;
    }> {
        try {
            this.subscriptionToolLogger.logSubscriptionPurchase(
                `Handling subscription purchase: ${subscriptionId} for company: ${companyId}`,
                'SubscriptionToolRestorationService'
            );

            // Get company to set up tenant connection
            const company = await this.companyRepository.findOneById(companyId);
            if (!company || !company.tenantId) {
                throw new Error(`Company or tenantId not found: ${companyId}`);
            }

            // Set up tenant connection
            const tenantConnection = null;
                    company.tenantId
                );

            // Perform purchase handling within tenant context
            // Tenant service removed: return await this.tenantContextService.run(
                { tenantId: company.tenantId, connection: tenantConnection },
                async () => {
                    let toolsUpdated = 0;
                    let toolsCreated = 0;

                    for (const tool of subscriptionTools) {
                        try {
                            // Check if settings already exist for this tool and subscription
                            const existingSettings =
                                await this.tenantToolSettingsRepository.findAll(
                                    {
                                        toolId: new Types.ObjectId(tool._id),
                                        subscriptionId: new Types.ObjectId(
                                            subscriptionId
                                        ),
                                        // Don't filter by soft_delete - we want to find even soft deleted settings
                                    }
                                );

                            if (existingSettings.length > 0) {
                                // Update existing settings with new subscription ID and restore if needed
                                for (const existingSetting of existingSettings) {
                                    await this.updateSettingSubscriptionId(
                                        existingSetting,
                                        subscriptionId
                                    );
                                    toolsUpdated++;
                                    this.logger.log(
                                        `Updated existing settings for tool ${tool.name} (toolId: ${tool._id}) with subscription ${subscriptionId}`
                                    );
                                }
                            } else {
                                // Settings don't exist, create new ones
                                await this.tenantToolSettingsRepository.create({
                                    toolId: new Types.ObjectId(tool._id),
                                    subscriptionId: new Types.ObjectId(
                                        subscriptionId
                                    ),
                                    status: 1,
                                    soft_delete: false,
                                });
                                toolsCreated++;
                                this.logger.log(
                                    `Created new settings for tool ${tool.name} for subscription ${subscriptionId}`
                                );
                            }
                        } catch (error) {
                            this.logger.error(
                                `Failed to process tool ${tool.name}: ${error.message}`
                            );
                            // Continue with other tools
                        }
                    }

                    return {
                        success: true,
                        toolsUpdated,
                        toolsCreated,
                        message: `Successfully processed ${subscriptionTools.length} tools: ${toolsUpdated} updated, ${toolsCreated} created`,
                    };
                }
            );
        } catch (error) {
            this.logger.error(
                `Error handling subscription purchase: ${error.message}`,
                error.stack
            );
            return {
                success: false,
                toolsUpdated: 0,
                toolsCreated: 0,
                message: 'Failed to handle subscription purchase',
                error: error.message,
            };
        }
    }

    /**
     * @deprecated Use handleSubscriptionPurchaseWithToolIds instead
     * Handle subscription purchase by tool names (less accurate)
     */
    async handleSubscriptionPurchase(
        subscriptionId: string,
        companyId: string,
        toolNames: string[]
    ): Promise<{
        success: boolean;
        toolsUpdated: number;
        toolsCreated: number;
        message: string;
        error?: string;
    }> {
        // Convert tool names to the expected format
        const subscriptionTools = toolNames.map(name => ({ _id: '', name }));
        return this.handleSubscriptionPurchaseWithToolIds(
            subscriptionId,
            companyId,
            subscriptionTools
        );
    }

    /**
     * Update a setting's subscription ID and restore if needed
     */
    private async updateSettingSubscriptionId(
        setting: any,
        newSubscriptionId: string
    ): Promise<void> {
        const updateData: any = {
            subscriptionId: new Types.ObjectId(newSubscriptionId),
            updatedAt: new Date()
        };

        // If setting was soft deleted, restore it
        if (setting.soft_delete) {
            updateData.soft_delete = false;
            updateData.deletedAt = null;
        }

        // Ensure setting is active
        updateData.status = 1; // ACTIVE status

        await this.tenantToolSettingsRepository.updateMany(
            { _id: setting._id },
            updateData
        );

        // Also restore related cron entries
        await this.restoreSettingRelatedData(setting._id.toString());
    }

    /**
     * Restore cron entries for a setting
     */
    private async restoreSettingRelatedData(settingId: string): Promise<void> {
        try {
            // Restore cron entries
            await this.tenantToolSettingCronRepository.updateMany(
                {
                    tenantToolSettingId: new Types.ObjectId(settingId),
                    soft_delete: true
                },
                {
                    soft_delete: false,
                    deletedAt: null
                }
            );

            this.logger.log(`Restored related data for setting ${settingId}`);

        } catch (error) {
            this.logger.error(`Failed to restore setting related data: ${error.message}`);
            // Don't throw as this is a secondary operation
        }
    }
}
