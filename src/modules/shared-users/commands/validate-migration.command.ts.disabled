import { Command, CommandRunner, Option } from 'nest-commander';
import { Logger } from '@nestjs/common';
import { SharedUserService } from '@modules/shared-users/services/shared-user.service';
import { UserService } from '@modules/user/services/user.service';
import { CompanyService } from '@modules/company/services/company.service';
import { ENUM_SHARED_USER_TYPE } from '@modules/shared-users/repository/entities/shared-user.entity';

interface ValidationResult {
    totalSharedUsers: number;
    validUsers: number;
    invalidUsers: number;
    issues: ValidationIssue[];
}

interface ValidationIssue {
    email: string;
    userType: string;
    issue: string;
    severity: 'warning' | 'error';
}

interface ValidateMigrationCommandOptions {
    fix?: boolean;
    verbose?: boolean;
}

@Command({
    name: 'validate-migration',
    description: 'Validate migration data integrity and consistency',
})
export class ValidateMigrationCommand extends CommandRunner {
    private readonly logger = new Logger(ValidateMigrationCommand.name);

    constructor(
        private readonly sharedUserService: SharedUserService,
        private readonly userService: UserService,
        private readonly companyService: CompanyService,) {
        super();
    }

    async run(
        passedParams: string[],
        options?: ValidateMigrationCommandOptions
    ): Promise<void> {
        this.logger.log('🔍 Starting migration validation');

        try {
            const result = await this.validateMigration(options?.fix);
            this.printValidationSummary(result, options?.verbose);

            if (result.invalidUsers > 0) {
                process.exit(1);
            }
        } catch (error) {
            this.logger.error('❌ Validation failed:', error);
            process.exit(1);
        }
    }

    private async validateMigration(fix?: boolean): Promise<ValidationResult> {
        const issues: ValidationIssue[] = [];
        let validUsers = 0;
        let invalidUsers = 0;

        // Get all shared users
        const adminUsers = await this.sharedUserService.findByUserType(ENUM_SHARED_USER_TYPE.ADMIN);
        const companyAdminUsers = await this.sharedUserService.findByUserType(ENUM_SHARED_USER_TYPE.COMPANY_ADMIN);
        const tenantUsers = await this.sharedUserService.findByUserType(ENUM_SHARED_USER_TYPE.TENANT_USER);

        const totalSharedUsers = adminUsers.length + companyAdminUsers.length + tenantUsers.length;
        this.logger.log(`📊 Found ${totalSharedUsers} shared users to validate`);

        // Validate Admin users
        this.logger.log('🔍 Validating Admin users...');
        for (const sharedUser of adminUsers) {
            const userIssues = await this.validateAdminUser(sharedUser, fix);
            if (userIssues.length > 0) {
                issues.push(...userIssues);
                invalidUsers++;
            } else {
                validUsers++;
            }
        }

        // Validate Company Admin users
        this.logger.log('🔍 Validating Company Admin users...');
        for (const sharedUser of companyAdminUsers) {
            const userIssues = await this.validateCompanyAdminUser(sharedUser, fix);
            if (userIssues.length > 0) {
                issues.push(...userIssues);
                invalidUsers++;
            } else {
                validUsers++;
            }
        }

        // Validate Tenant users
        this.logger.log('🔍 Validating Tenant users...');
        for (const sharedUser of tenantUsers) {
            const userIssues = await this.validateTenantUser(sharedUser, fix);
            if (userIssues.length > 0) {
                issues.push(...userIssues);
                invalidUsers++;
            } else {
                validUsers++;
            }
        }

        return {
            totalSharedUsers,
            validUsers,
            invalidUsers,
            issues,
        };
    }

    private async validateAdminUser(sharedUser: any, fix?: boolean): Promise<ValidationIssue[]> {
        const issues: ValidationIssue[] = [];

        // Check tenantId should be null for admin users
        if (sharedUser.tenantId !== null) {
            issues.push({
                email: sharedUser.email,
                userType: sharedUser.userType,
                issue: `Admin user has non-null tenantId: ${sharedUser.tenantId}`,
                severity: 'error',
            });

            if (fix) {
                try {
                    await this.sharedUserService.updateByEmail(sharedUser.email, { tenantId: null });
                    this.logger.log(`🔧 Fixed tenantId for admin user: ${sharedUser.email}`);
                } catch (error) {
                    this.logger.error(`Failed to fix tenantId for ${sharedUser.email}:`, error);
                }
            }
        }

        // Check if corresponding user exists in master database
        try {
            const masterUser = await this.userService.findOneByEmail(sharedUser.email);
            if (!masterUser) {
                issues.push({
                    email: sharedUser.email,
                    userType: sharedUser.userType,
                    issue: 'Admin user not found in master database',
                    severity: 'error',
                });
            }
        } catch (error) {
            issues.push({
                email: sharedUser.email,
                userType: sharedUser.userType,
                issue: `Error checking master database: ${error.message}`,
                severity: 'error',
            });
        }

        return issues;
    }

    private async validateCompanyAdminUser(sharedUser: any, fix?: boolean): Promise<ValidationIssue[]> {
        const issues: ValidationIssue[] = [];

        // Check if corresponding user exists in master database
        try {
            const masterUser = await this.userService.findOneByEmail(sharedUser.email);
            if (!masterUser) {
                issues.push({
                    email: sharedUser.email,
                    userType: sharedUser.userType,
                    issue: 'Company Admin user not found in master database',
                    severity: 'error',
                });
                return issues;
            }

            // Check if company exists and has correct tenantId
            const company = await this.companyService.findOneByUserId(masterUser._id);
            if (!company) {
                issues.push({
                    email: sharedUser.email,
                    userType: sharedUser.userType,
                    issue: 'Company not found for Company Admin user',
                    severity: 'error',
                });
            } else {
                // Check tenantId consistency
                if (sharedUser.tenantId !== company.tenantId) {
                    issues.push({
                        email: sharedUser.email,
                        userType: sharedUser.userType,
                        issue: `TenantId mismatch: shared(${sharedUser.tenantId}) vs company(${company.tenantId})`,
                        severity: 'error',
                    });

                    if (fix && company.tenantId) {
                        try {
                            await this.sharedUserService.updateByEmail(sharedUser.email, { tenantId: company.tenantId });
                            this.logger.log(`🔧 Fixed tenantId for company admin: ${sharedUser.email}`);
                        } catch (error) {
                            this.logger.error(`Failed to fix tenantId for ${sharedUser.email}:`, error);
                        }
                    }
                }
            }
        } catch (error) {
            issues.push({
                email: sharedUser.email,
                userType: sharedUser.userType,
                issue: `Error validating company admin: ${error.message}`,
                severity: 'error',
            });
        }

        return issues;
    }

    private async validateTenantUser(sharedUser: any, fix?: boolean): Promise<ValidationIssue[]> {
        const issues: ValidationIssue[] = [];

        // Check tenantId is not null
        if (!sharedUser.tenantId) {
            issues.push({
                email: sharedUser.email,
                userType: sharedUser.userType,
                issue: 'Tenant user has null tenantId',
                severity: 'error',
            });
            return issues;
        }

        // Check if tenant exists and is accessible
        try {
            const tenantConnection = await this.multiTenantService.getTenantConnection(sharedUser.tenantId);
            
            // Register schema if not already registered
            let tenantUserModel;
            try {
                tenantUserModel = tenantConnection.model('users');
            } catch (error) {
                // Import schema and register it
                const { TenantUserSchema } = await import('@modules/tenant/user/repository/entities/tenant-user.entity');
                tenantUserModel = tenantConnection.model('users', TenantUserSchema);
            }
            
            const tenantUser = await tenantUserModel.findOne({ email: sharedUser.email }).exec();

            if (!tenantUser) {
                issues.push({
                    email: sharedUser.email,
                    userType: sharedUser.userType,
                    issue: `Tenant user not found in tenant database: ${sharedUser.tenantId}`,
                    severity: 'error',
                });
            }
        } catch (error) {
            issues.push({
                email: sharedUser.email,
                userType: sharedUser.userType,
                issue: `Error accessing tenant database ${sharedUser.tenantId}: ${error.message}`,
                severity: 'error',
            });
        }

        return issues;
    }

    private printValidationSummary(result: ValidationResult, verbose?: boolean): void {
        this.logger.log('\n📊 VALIDATION SUMMARY');
        this.logger.log('═'.repeat(50));
        this.logger.log(`📈 Total Shared Users: ${result.totalSharedUsers}`);
        this.logger.log(`✅ Valid Users: ${result.validUsers}`);
        this.logger.log(`❌ Invalid Users: ${result.invalidUsers}`);
        this.logger.log(`📊 Validity Rate: ${result.totalSharedUsers > 0 ? ((result.validUsers / result.totalSharedUsers) * 100).toFixed(2) : 0}%`);

        if (result.issues.length > 0) {
            const errors = result.issues.filter(i => i.severity === 'error');
            const warnings = result.issues.filter(i => i.severity === 'warning');

            if (errors.length > 0) {
                this.logger.log(`\n❌ ERRORS (${errors.length}):`);
                this.logger.log('─'.repeat(30));
                errors.forEach((issue, index) => {
                    this.logger.log(`${index + 1}. ${issue.email} (${issue.userType}): ${issue.issue}`);
                });
            }

            if (warnings.length > 0) {
                this.logger.log(`\n⚠️ WARNINGS (${warnings.length}):`);
                this.logger.log('─'.repeat(30));
                warnings.forEach((issue, index) => {
                    this.logger.log(`${index + 1}. ${issue.email} (${issue.userType}): ${issue.issue}`);
                });
            }
        }

        if (result.invalidUsers === 0) {
            this.logger.log('\n🎉 All users are valid!');
        } else {
            this.logger.log(`\n⚠️ Found ${result.invalidUsers} invalid users that need attention.`);
        }
    }

    @Option({
        flags: '-f, --fix',
        description: 'Attempt to fix validation issues automatically',
    })
    parseFix(): boolean {
        return true;
    }

    @Option({
        flags: '-v, --verbose',
        description: 'Enable verbose output with detailed results',
    })
    parseVerbose(): boolean {
        return true;
    }
}