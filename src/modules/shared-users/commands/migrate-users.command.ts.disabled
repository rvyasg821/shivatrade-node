import { Command, CommandRunner, Option } from 'nest-commander';
import { Logger } from '@nestjs/common';
import { MigrationService } from '@modules/shared-users/services/migration.service';
import { IMigrationResult } from '@modules/shared-users/interfaces/migration.interface';

interface MigrateUsersCommandOptions {
    dryRun?: boolean;
    userType?: string;
    verbose?: boolean;
}

@Command({
    name: 'migrate-users',
    description: 'Migrate existing users to sharedUsers table for unified authentication',
})
export class MigrateUsersCommand extends CommandRunner {
    private readonly logger = new Logger(MigrateUsersCommand.name);

    constructor(private readonly migrationService: MigrationService) {
        super();
    }

    async run(
        passedParams: string[],
        options?: MigrateUsersCommandOptions
    ): Promise<void> {
        this.logger.log('🚀 Starting user migration to sharedUsers table');

        if (options?.dryRun) {
            this.logger.log('🔍 DRY RUN MODE - No changes will be made');
        }

        if (options?.verbose) {
            this.logger.log('📝 Verbose mode enabled');
        }

        try {
            let result: IMigrationResult;

            if (options?.userType) {
                this.logger.log(`🎯 Migrating specific user type: ${options.userType}`);
                result = await this.migrateSpecificUserType(options.userType, options?.dryRun);
            } else {
                this.logger.log('🌐 Migrating all user types');
                if (options?.dryRun) {
                    this.logger.log('⚠️ Dry run for full migration not implemented - use specific user types');
                    return;
                }
                result = await this.migrationService.migrateExistingUsers();
            }

            this.printMigrationSummary(result, options?.verbose);
        } catch (error) {
            this.logger.error('❌ Migration failed:', error);
            process.exit(1);
        }
    }

    private async migrateSpecificUserType(
        userType: string,
        dryRun?: boolean
    ): Promise<IMigrationResult> {
        if (dryRun) {
            this.logger.log(`🔍 Would migrate ${userType} users (dry run)`);
            // Return mock result for dry run
            return {
                totalProcessed: 0,
                successful: 0,
                failed: 0,
                errors: [],
                results: [],
            };
        }

        switch (userType.toLowerCase()) {
            case 'admin':
            case 'super-admin':
                const adminResults = await this.migrationService.migrateSuperAdmins();
                return {
                    totalProcessed: adminResults.length,
                    successful: adminResults.filter(r => r.success).length,
                    failed: adminResults.filter(r => !r.success).length,
                    errors: adminResults.filter(r => !r.success).map(r => ({
                        email: r.email,
                        error: r.error || 'Unknown error',
                        userType: r.userType,
                    })),
                    results: adminResults,
                };

            case 'company-admin':
                const companyResults = await this.migrationService.migrateCompanyAdmins();
                return {
                    totalProcessed: companyResults.length,
                    successful: companyResults.filter(r => r.success).length,
                    failed: companyResults.filter(r => !r.success).length,
                    errors: companyResults.filter(r => !r.success).map(r => ({
                        email: r.email,
                        error: r.error || 'Unknown error',
                        userType: r.userType,
                    })),
                    results: companyResults,
                };

            case 'tenant-user':
                const tenantResults = await this.migrationService.migrateTenantUsers();
                return {
                    totalProcessed: tenantResults.length,
                    successful: tenantResults.filter(r => r.success).length,
                    failed: tenantResults.filter(r => !r.success).length,
                    errors: tenantResults.filter(r => !r.success).map(r => ({
                        email: r.email,
                        error: r.error || 'Unknown error',
                        userType: r.userType,
                    })),
                    results: tenantResults,
                };

            default:
                throw new Error(`Invalid user type: ${userType}. Valid types: admin, company-admin, tenant-user`);
        }
    }

    private printMigrationSummary(result: IMigrationResult, verbose?: boolean): void {
        this.logger.log('\n📊 MIGRATION SUMMARY');
        this.logger.log('═'.repeat(50));
        this.logger.log(`📈 Total Processed: ${result.totalProcessed}`);
        this.logger.log(`✅ Successful: ${result.successful}`);
        this.logger.log(`❌ Failed: ${result.failed}`);
        this.logger.log(`📊 Success Rate: ${result.totalProcessed > 0 ? ((result.successful / result.totalProcessed) * 100).toFixed(2) : 0}%`);

        if (result.errors.length > 0) {
            this.logger.log('\n❌ ERRORS:');
            this.logger.log('─'.repeat(30));
            result.errors.forEach((error, index) => {
                this.logger.log(`${index + 1}. ${error.email} (${error.userType}): ${error.error}`);
            });
        }

        if (verbose && result.results.length > 0) {
            this.logger.log('\n📋 DETAILED RESULTS:');
            this.logger.log('─'.repeat(40));
            result.results.forEach((userResult, index) => {
                const status = userResult.success ? '✅' : '❌';
                const tenantInfo = userResult.tenantId ? ` (tenant: ${userResult.tenantId})` : '';
                this.logger.log(`${index + 1}. ${status} ${userResult.email} - ${userResult.userType}${tenantInfo}`);
                if (!userResult.success && userResult.error) {
                    this.logger.log(`   Error: ${userResult.error}`);
                }
            });
        }

        this.logger.log('\n🎉 Migration completed!');
    }

    @Option({
        flags: '-d, --dry-run',
        description: 'Run migration in dry-run mode (no changes will be made)',
    })
    parseDryRun(): boolean {
        return true;
    }

    @Option({
        flags: '-t, --user-type <type>',
        description: 'Migrate specific user type only (admin, company-admin, tenant-user)',
    })
    parseUserType(val: string): string {
        return val;
    }

    @Option({
        flags: '-v, --verbose',
        description: 'Enable verbose output with detailed results',
    })
    parseVerbose(): boolean {
        return true;
    }
}