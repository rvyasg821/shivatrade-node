import { Injectable, Logger } from '@nestjs/common';
import { UserService } from '@modules/user/services/user.service';
import { CompanyService } from '@modules/company/services/company.service';
import { RoleService } from '@modules/role/services/role.service';
import { SharedUserService } from '@modules/shared-users/services/shared-user.service';
import { ENUM_SHARED_USER_TYPE } from '@modules/shared-users/repository/entities/shared-user.entity';
import { ENUM_SYSTEM_ROLE } from '@modules/role/enums/role.enum';
import {
    IMigrationService,
    IMigrationResult,
    IMigrationUserResult,
    IMigrationError,
} from '@modules/shared-users/interfaces/migration.interface';

@Injectable()
export class MigrationService implements IMigrationService {
    private readonly logger = new Logger(MigrationService.name);

    constructor(
        private readonly userService: UserService,
        private readonly companyService: CompanyService,
        private readonly roleService: RoleService,private readonly sharedUserService: SharedUserService
    ) {}

    async migrateExistingUsers(): Promise<IMigrationResult> {
        this.logger.log(
            'Starting migration of existing users to sharedUsers table'
        );

        const results: IMigrationUserResult[] = [];
        const errors: IMigrationError[] = [];

        try {
            // Migrate Super Admins
            this.logger.log('Migrating Super Admin users...');
            const superAdminResults = await this.migrateSuperAdmins();
            results.push(...superAdminResults);

            // Migrate Company Admins
            this.logger.log('Migrating Company Admin users...');
            const companyAdminResults = await this.migrateCompanyAdmins();
            results.push(...companyAdminResults);

            // Migrate Tenant Users
            this.logger.log('Migrating Tenant Users...');
            const tenantUserResults = await this.migrateTenantUsers();
            results.push(...tenantUserResults);

            // Collect errors
            results.forEach(result => {
                if (!result.success) {
                    errors.push({
                        email: result.email,
                        error: result.error || 'Unknown error',
                        userType: result.userType,
                    });
                }
            });

            const successful = results.filter(r => r.success).length;
            const failed = results.filter(r => !r.success).length;

            const migrationResult: IMigrationResult = {
                totalProcessed: results.length,
                successful,
                failed,
                errors,
                results,
            };

            this.logger.log(
                `Migration completed: ${successful} successful, ${failed} failed`
            );
            return migrationResult;
        } catch (error) {
            this.logger.error('Migration failed with error:', error);
            throw error;
        }
    }

    async migrateSuperAdmins(): Promise<IMigrationUserResult[]> {
        const results: IMigrationUserResult[] = [];

        try {
            // Get Super Admin role
            const superAdminRole = await this.roleService.findOneByName(
                ENUM_SYSTEM_ROLE.SUPER_ADMIN
            );
            if (!superAdminRole) {
                this.logger.warn(
                    'Super Admin role not found, skipping Super Admin migration'
                );
                return results;
            }

            // Find all users with Super Admin role
            const superAdmins = await this.userService.findAll({
                find: { role: superAdminRole._id },
            });

            this.logger.log(
                `Found ${superAdmins.length} Super Admin users to migrate`
            );

            for (const admin of superAdmins) {
                try {
                    // Check if already exists in sharedUsers
                    const existingSharedUser =
                        await this.sharedUserService.existsByEmail(admin.email);
                    if (existingSharedUser) {
                        this.logger.warn(
                            `Super Admin ${admin.email} already exists in sharedUsers, skipping`
                        );
                        results.push({
                            email: admin.email,
                            success: true,
                            userType: ENUM_SHARED_USER_TYPE.ADMIN,
                            tenantId: null,
                        });
                        continue;
                    }

                    // Create shared user entry
                    await this.sharedUserService.create({
                        email: admin.email,
                        password: admin.password,
                        tenantId: null,
                        userType: ENUM_SHARED_USER_TYPE.ADMIN,
                        originalUserId: admin?._id?.toString() || null,
                    });

                    results.push({
                        email: admin.email,
                        success: true,
                        userType: ENUM_SHARED_USER_TYPE.ADMIN,
                        tenantId: null,
                    });

                    this.logger.log(
                        `Successfully migrated Super Admin: ${admin.email}`
                    );
                } catch (error) {
                    this.logger.error(
                        `Failed to migrate Super Admin ${admin.email}:`,
                        error
                    );
                    results.push({
                        email: admin.email,
                        success: false,
                        error: error.message,
                        userType: ENUM_SHARED_USER_TYPE.ADMIN,
                        tenantId: null,
                    });
                }
            }
        } catch (error) {
            this.logger.error('Error during Super Admin migration:', error);
            throw error;
        }

        return results;
    }

    async migrateCompanyAdmins(): Promise<IMigrationUserResult[]> {
        const results: IMigrationUserResult[] = [];

        try {
            // Get Company Admin role
            const companyAdminRole = await this.roleService.findOneByName(
                ENUM_SYSTEM_ROLE.COMPANY_ADMIN
            );
            if (!companyAdminRole) {
                this.logger.warn(
                    'Company Admin role not found, skipping Company Admin migration'
                );
                return results;
            }

            // Find all users with Company Admin role
            const companyAdmins = await this.userService.findAll({
                find: { role: companyAdminRole._id },
            });

            this.logger.log(
                `Found ${companyAdmins.length} Company Admin users to migrate`
            );

            for (const admin of companyAdmins) {
                try {
                    // Check if already exists in sharedUsers
                    const existingSharedUser =
                        await this.sharedUserService.existsByEmail(admin.email);
                    if (existingSharedUser) {
                        this.logger.warn(
                            `Company Admin ${admin.email} already exists in sharedUsers, skipping`
                        );
                        results.push({
                            email: admin.email,
                            success: true,
                            userType: ENUM_SHARED_USER_TYPE.COMPANY_ADMIN,
                        });
                        continue;
                    }

                    // Find company for this admin
                    const company = await this.companyService.findOneByUserId(
                        admin._id
                    );
                    if (!company) {
                        this.logger.warn(
                            `No company found for Company Admin ${admin.email}, using null tenantId`
                        );
                        results.push({
                            email: admin.email,
                            success: false,
                            error: 'No company found for Company Admin',
                            userType: ENUM_SHARED_USER_TYPE.COMPANY_ADMIN,
                        });
                        continue;
                    }

                    // Create shared user entry
                    await this.sharedUserService.create({
                        email: admin.email,
                        password: admin.password,
                        tenantId: company.tenantId,
                        userType: ENUM_SHARED_USER_TYPE.COMPANY_ADMIN,
                        originalUserId: admin?._id?.toString() || null,
                    });

                    results.push({
                        email: admin.email,
                        success: true,
                        userType: ENUM_SHARED_USER_TYPE.COMPANY_ADMIN,
                        tenantId: company.tenantId,
                    });

                    this.logger.log(
                        `Successfully migrated Company Admin: ${admin.email} with tenantId: ${company.tenantId}`
                    );
                } catch (error) {
                    this.logger.error(
                        `Failed to migrate Company Admin ${admin.email}:`,
                        error
                    );
                    results.push({
                        email: admin.email,
                        success: false,
                        error: error.message,
                        userType: ENUM_SHARED_USER_TYPE.COMPANY_ADMIN,
                    });
                }
            }
        } catch (error) {
            this.logger.error('Error during Company Admin migration:', error);
            throw error;
        }

        return results;
    }

    async migrateTenantUsers(): Promise<IMigrationUserResult[]> {
        const results: IMigrationUserResult[] = [];

        try {
            // Get all active tenants
            const tenants = await this.multiTenantService.getAllTenants();
            this.logger.log(
                `Found ${tenants.length} tenants to process for user migration`
            );

            for (const tenant of tenants) {
                try {
                    // Get tenant database connection
                    const tenantConnection =
                        await this.multiTenantService.getTenantConnection(
                            tenant.tenantId
                        );

                    // Register schema if not already registered
                    let tenantUserModel;
                    try {
                        tenantUserModel = tenantConnection.model('users');
                    } catch (error) {
                        // Import schema and register it
                        const { TenantUserSchema } = await import(
                            '@modules/tenant/user/repository/entities/tenant-user.entity'
                        );
                        tenantUserModel = tenantConnection.model(
                            'users',
                            TenantUserSchema
                        );
                    }

                    // Get all users from tenant database
                    const tenantUsers = await tenantUserModel.find({}).exec();
                    this.logger.log(
                        `Found ${tenantUsers.length} users in tenant ${tenant.tenantId}`
                    );

                    for (const tenantUser of tenantUsers) {
                        try {
                            // Check if already exists in sharedUsers
                            const existingSharedUser =
                                await this.sharedUserService.existsByEmail(
                                    tenantUser.email
                                );
                            if (existingSharedUser) {
                                this.logger.warn(
                                    `Tenant User ${tenantUser.email} already exists in sharedUsers, skipping`
                                );
                                results.push({
                                    email: tenantUser.email,
                                    success: true,
                                    userType: ENUM_SHARED_USER_TYPE.TENANT_USER,
                                    tenantId: tenant.tenantId,
                                });
                                continue;
                            }

                            // Create shared user entry
                            await this.sharedUserService.create({
                                email: tenantUser.email,
                                password: tenantUser.password,
                                tenantId: tenant.tenantId,
                                userType: ENUM_SHARED_USER_TYPE.TENANT_USER,
                                originalUserId: tenantUser?._id?.toString() || null,
                            });

                            results.push({
                                email: tenantUser.email,
                                success: true,
                                userType: ENUM_SHARED_USER_TYPE.TENANT_USER,
                                tenantId: tenant.tenantId,
                            });

                            this.logger.log(
                                `Successfully migrated Tenant User: ${tenantUser.email} from tenant: ${tenant.tenantId}`
                            );
                        } catch (error) {
                            this.logger.error(
                                `Failed to migrate Tenant User ${tenantUser.email} from tenant ${tenant.tenantId}:`,
                                error
                            );
                            results.push({
                                email: tenantUser.email,
                                success: false,
                                error: error.message,
                                userType: ENUM_SHARED_USER_TYPE.TENANT_USER,
                                tenantId: tenant.tenantId,
                            });
                        }
                    }
                } catch (error) {
                    this.logger.error(
                        `Failed to process tenant ${tenant.tenantId}:`,
                        error
                    );
                }
            }
        } catch (error) {
            this.logger.error('Error during Tenant User migration:', error);
            throw error;
        }

        return results;
    }
}
