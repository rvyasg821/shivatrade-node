import { Injectable, Logger, Inject } from '@nestjs/common';
import { CACHE_MANAGER } from '@nestjs/cache-manager';
import { Cache } from 'cache-manager';
import { Types } from 'mongoose';
import { PlanRepository } from '@modules/plan/repository/repositories/plan.repository';
import { SubscriptionRepository } from '@modules/subscription/repository/repositories/subscription.repository';
import { WidgetRepository } from '@modules/widget/repository/repositories/widget.repository';
import { CompanyRepository } from '@modules/company/repository/repositories/company.repository';
import { ToolsRepository } from '../repository/repositories/tools.repository';
import { ICascadeStepResult } from '../interfaces/tool-deletion-job.interface';
import { ENUM_TOOLS_STATUS } from '../enums/tools.enum';
import { WidgetSchema } from '@modules/widget/repository/entities/widget.entity';
import { writeFileSync, appendFileSync } from 'fs';
import { join } from 'path';

@Injectable()
export class CascadeOperationsService {
    private readonly logFile = join(process.cwd(), 'logs', 'tool-deletion-debug.log');

    constructor(
        private readonly planRepository: PlanRepository,
        private readonly subscriptionRepository: SubscriptionRepository,
        private readonly widgetRepository: WidgetRepository,
        private readonly toolsRepository: ToolsRepository,private readonly companyRepository: CompanyRepository,@Inject(CACHE_MANAGER) private readonly cacheManager: Cache,
    ) { }

    private log(message: string) {
        const timestamp = new Date().toISOString();
        const logMessage = `[${timestamp}] ${message}\n`;
        try {
            appendFileSync(this.logFile, logMessage);
        } catch (error) {
            // Ignore file write errors
            appendFileSync(this.logFile, error.message ?? 'error');
        }
        console.log(message);
    }

    async removeToolFromPlans(toolId: string): Promise<ICascadeStepResult> {
        const startTime = Date.now();
        const stepName = 'Remove Tool from Plans';

        try {
            this.log(`📋 Starting ${stepName} for tool: ${toolId}`);

            // Query with both string and ObjectId formats since plans might store either
            const plansWithTool = await this.planRepository.findAll({
                // $or: [
                //     { 'tools._id': toolId },
                //     { 'tools._id': new Types.ObjectId(toolId) }
                // ],
                // soft_delete: false,
            });

            this.log(`   Found ${plansWithTool.length} plans containing tool ${toolId}`);

            let affectedCount = 0;

            // Remove the tool from each plan
            for (const plan of plansWithTool) {
                const originalToolCount = plan.tools.length;

                this.log(`   Plan "${plan.name}" has ${originalToolCount} tools before removal`);

                plan.tools = plan.tools.filter(
                    (tool) => {
                        const toolIdStr = tool._id?.toString();
                        const targetIdStr = toolId?.toString();
                        const match = toolIdStr !== targetIdStr;
                        if (!match) {
                            this.log(`      Removing tool: ${tool.name} (${toolIdStr})`);
                        }
                        return match;
                    }
                );

                this.log(`   Plan "${plan.name}" has ${plan.tools.length} tools after removal`);

                // Only save and count if the tool was actually removed
                if (plan.tools.length < originalToolCount) {
                    await this.planRepository.save(plan);
                    affectedCount++;
                    this.log(`   ✅ Saved plan: ${plan._id} (${plan.name})`);
                }
            }

            const executionTime = Date.now() - startTime;
            this.log(`   ✅ ${stepName} completed: ${affectedCount} plans updated in ${executionTime}ms`);

            return {
                stepName,
                success: true,
                affectedCount,
                executionTime,
            };
        } catch (error) {
            const executionTime = Date.now() - startTime;
            this.log(`   ❌ ${stepName} failed: ${error.message}`);
            this.log(`   Stack: ${error.stack}`);

            return {
                stepName,
                success: false,
                affectedCount: 0,
                executionTime,
                error: error.message,
            };
        }
    }

    async removeToolFromSubscriptions(toolId: string): Promise<ICascadeStepResult> {
        const startTime = Date.now();
        const stepName = 'Remove Tool from Subscriptions';

        try {
            console.log(`💳 Starting ${stepName} for tool: ${toolId}`);

            // Find all active subscriptions that contain this tool (handle both string and ObjectId)
            const subscriptionsWithTool = await this.subscriptionRepository.findAll({
                // $or: [
                //     { 'tools._id': toolId },
                //     { 'tools._id': new Types.ObjectId(toolId) }
                // ],
                // status: true,
                // soft_delete: false,
            });

            console.log(`   Found ${subscriptionsWithTool.length} subscriptions containing tool ${toolId}`);

            let affectedCount = 0;

            // Remove the tool from each subscription and recalculate pricing
            for (const subscription of subscriptionsWithTool) {
                // Find the tool being removed to get its price
                const removedTool = subscription.tools.find(
                    (tool) => tool._id?.toString() === toolId?.toString()
                );

                if (removedTool) {
                    console.log(`   Removing tool "${removedTool.name}" (price: ${removedTool.price}) from subscription ${subscription._id}`);

                    // Remove the tool from the array
                    subscription.tools = subscription.tools.filter(
                        (tool) => tool._id?.toString() !== toolId?.toString()
                    );

                    // Recalculate pricing
                    subscription.tools_price = subscription.tools_price - removedTool.price;
                    subscription.total_price = subscription.platform_price + subscription.tools_price;

                    // Recalculate final price with tax
                    const taxRate = subscription.tax_value / (subscription.total_price + subscription.tools_price - subscription.tools_price + removedTool.price) || 0;
                    subscription.tax_value = subscription.total_price * taxRate;
                    subscription.final_price = subscription.total_price + subscription.tax_value;

                    await this.subscriptionRepository.save(subscription);

                    // Invalidate subscription cache
                    await this.invalidateSubscriptionCache(subscription._id.toString(), subscription.user_id.toString());

                    affectedCount++;
                    console.log(`   ✅ Updated subscription ${subscription._id} - New total: ${subscription.total_price}`);
                }
            }

            const executionTime = Date.now() - startTime;
            console.log(`   ✅ ${stepName} completed: ${affectedCount} subscriptions updated in ${executionTime}ms`);

            return {
                stepName,
                success: true,
                affectedCount,
                executionTime,
            };
        } catch (error) {
            const executionTime = Date.now() - startTime;
            console.error(`${stepName} failed: ${error.message}`, error.stack);

            return {
                stepName,
                success: false,
                affectedCount: 0,
                executionTime,
                error: error.message,
            };
        }
    }

    async deleteToolWidgets(toolSlug: string): Promise<ICascadeStepResult> {
        const startTime = Date.now();
        const stepName = 'Delete Tool Widgets';

        try {
            console.log(`Starting ${stepName} for tool slug: ${toolSlug}`);

            let totalAffectedCount = 0;

            // Soft delete widgets in master database
            const masterWidgets = await this.widgetRepository.findAll({
                tool_slug: toolSlug,
                soft_delete: false,
            });

            for (const widget of masterWidgets) {
                widget.soft_delete = true;
                await this.widgetRepository.save(widget);
                totalAffectedCount++;
            }

            console.log(`Soft deleted ${masterWidgets.length} widgets in master database`);

            // Get all companies to access their tenant databases
            const companies = await this.companyRepository.findAll({});

            // Process each tenant database
            for (const company of companies) {
                try {
                    if (!company.tenantId) {
                        console.log(`No tenantId found for company: ${company?.company_name}`);
                        continue;
                    }

                    // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

                    // Tenant service removed: await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
                        // Use widget repository with tenant context
                        const tenantWidgets = await this.widgetRepository.findByTenantAndFilters(company.tenantId, {
                            tool_slug: toolSlug,
                            soft_delete: false,
                        });

                        for (const widget of tenantWidgets) {
                            await this.widgetRepository.softDeleteById(company.tenantId, widget._id.toString());
                            totalAffectedCount++;
                        }

                        console.log(`Soft deleted ${tenantWidgets.length} widgets for tenant: ${company._id}`);
                    });
                } catch (tenantError) {
                    console.error(
                        `Failed to delete widgets for tenant ${company._id}: ${tenantError.message}`,
                        tenantError.stack
                    );
                    // Continue with other tenants
                }
            }

            const executionTime = Date.now() - startTime;
            console.log(`${stepName} completed: ${totalAffectedCount} widgets deleted in ${executionTime}ms`);

            return {
                stepName,
                success: true,
                affectedCount: totalAffectedCount,
                executionTime,
            };
        } catch (error) {
            const executionTime = Date.now() - startTime;
            console.error(`${stepName} failed: ${error.message}`, error.stack);

            return {
                stepName,
                success: false,
                affectedCount: 0,
                executionTime,
                error: error.message,
            };
        }
    }

    async deleteToolSettings(toolSlug: string): Promise<ICascadeStepResult> {
        const startTime = Date.now();
        const stepName = 'Delete Tool Settings and Cron Schedules';

        try {
            console.log(`Starting ${stepName} for tool slug: ${toolSlug}`);

            let totalAffectedCount = 0;

            // Get all companies to access their tenant databases
            const companies = await this.companyRepository.findAll({});

            // Process each tenant database
            for (const company of companies) {
                try {
                    if (!company.tenantId) {
                        console.log(`No tenantId found for company: ${company?.company_name}`);
                        continue;
                    }

                    // Tenant service removed: const tenantConnection = await this.tenantConnectionService.getConnection(company.tenantId);

                    // Tenant service removed: await this.tenantContextService.run({ tenantId: company.tenantId, connection: tenantConnection }, async () => {
// Tenant tool settings removed - using central database only
                        //                         const TenantToolSettingsModel = tenantConnection.model('tenant_tool_settings', TenantToolSettingsSchema);
// Tenant tool setting cron removed - using central database only
                        //                         const TenantToolSettingCronModel = tenantConnection.model('tenant_tool_setting_crons', TenantToolSettingCronSchema);

                        // Find all settings for this tool
                        const settings = await TenantToolSettingsModel.find({
                            slug: toolSlug,
                            soft_delete: false,
                        });

                        for (const setting of settings) {
                            // Soft delete the setting
                            setting.soft_delete = true;
                            await setting.save();
                            totalAffectedCount++;

                            // Soft delete all associated cron schedules
                            const crons = await TenantToolSettingCronModel.find({
                                tenantToolSettingId: setting._id,
                                soft_delete: false,
                            });

                            for (const cron of crons) {
                                cron.soft_delete = true;
                                cron.isCronEnabled = false;
                                await cron.save();
                                totalAffectedCount++;
                            }

                            console.log(
                                `Soft deleted setting ${setting._id} and ${crons.length} cron schedules for tenant: ${company._id}`
                            );
                        }
                    });
                } catch (tenantError) {
                    console.error(
                        `Failed to delete settings for tenant ${company._id}: ${tenantError.message}`,
                        tenantError.stack
                    );
                    // Continue with other tenants
                }
            }

            const executionTime = Date.now() - startTime;
            console.log(`${stepName} completed: ${totalAffectedCount} settings/crons deleted in ${executionTime}ms`);

            return {
                stepName,
                success: true,
                affectedCount: totalAffectedCount,
                executionTime,
            };
        } catch (error) {
            const executionTime = Date.now() - startTime;
            console.error(`${stepName} failed: ${error.message}`, error.stack);

            return {
                stepName,
                success: false,
                affectedCount: 0,
                executionTime,
                error: error.message,
            };
        }
    }

    async updateToolStatus(
        toolId: string,
        operation: 'delete' | 'inactivate'
    ): Promise<ICascadeStepResult> {
        const startTime = Date.now();
        const stepName = 'Update Tool Status';

        try {
            console.log(`Starting ${stepName} for tool: ${toolId}, operation: ${operation}`);

            const tool = await this.toolsRepository.findOneById(toolId);

            if (!tool) {
                throw new Error(`Tool not found: ${toolId}`);
            }

            if (operation === 'delete') {
                tool.soft_delete = true;
            } else if (operation === 'inactivate') {
                tool.status = ENUM_TOOLS_STATUS.INACTIVE;
            }

            await this.toolsRepository.save(tool);

            // Invalidate tool cache
            await this.invalidateToolCache(toolId);

            const executionTime = Date.now() - startTime;
            console.log(`${stepName} completed in ${executionTime}ms`);

            return {
                stepName,
                success: true,
                affectedCount: 1,
                executionTime,
            };
        } catch (error) {
            const executionTime = Date.now() - startTime;
            console.error(`${stepName} failed: ${error.message}`, error.stack);

            return {
                stepName,
                success: false,
                affectedCount: 0,
                executionTime,
                error: error.message,
            };
        }
    }

    private async invalidateToolCache(toolId: string): Promise<void> {
        try {
            const cacheKeys = [
                `tools:id:${toolId}`,
                'tools:active',
            ];

            await Promise.all(
                cacheKeys.map(key => this.cacheManager.del(key))
            );

            console.debug(`Invalidated cache for tool: ${toolId}`);
        } catch (error) {
            console.error(`Failed to invalidate tool cache: ${error.message}`);
        }
    }

    private async invalidateSubscriptionCache(subscriptionId: string, userId: string): Promise<void> {
        try {
            const cacheKeys = [
                `subscriptions:id:${subscriptionId}`,
                `subscriptions:user:${userId}`,
                'subscriptions:active',
            ];

            await Promise.all(
                cacheKeys.map(key => this.cacheManager.del(key))
            );

            console.debug(`Invalidated cache for subscription: ${subscriptionId}`);
        } catch (error) {
            console.error(`Failed to invalidate subscription cache: ${error.message}`);
        }
    }
}
