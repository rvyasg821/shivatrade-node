APP_NAME="RANSOMBLOC"
APP_ENV=local
APP_LANGUAGE=en
APP_TIMEZONE="Europe/London"
 
HOME_URL=https://example.id
HOME_NAME="RANSOMBLOC"
 
HTTP_HOST=0.0.0.0
HTTP_PORT=3002
 
DEBUG_ENABLE=true
DEBUG_LEVEL=debug
DEBUG_INTO_FILE=false
DEBUG_PRETTIER=true
 
MIDDLEWARE_CORS_ORIGIN=*
 
URL_VERSIONING_ENABLE=true
URL_VERSION=1

FRONT_URL=
FRONT_LOGO_URL=

# IMPORTANT: Replace with your actual database credentials
# DO NOT commit actual credentials to version control
DATABASE_URL="mongodb://localhost:27017/test_db?retryWrites=true&w=majority"
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_strong_database_password
# &replicaSet=rs0"
DATABASE_DEBUG=false
 
AUTH_JWT_ISSUER=https://example.id
AUTH_JWT_AUDIENCE=RamsomBloc
 
# CRITICAL SECURITY: Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use these example values in any environment
AUTH_JWT_ACCESS_TOKEN_SECRET=REPLACE_WITH_128_CHAR_HEX_STRING_GENERATED_BY_CRYPTO_RANDOMBYTES_64
AUTH_JWT_ACCESS_TOKEN_EXPIRED=1h

# Generate a DIFFERENT secret for refresh tokens
AUTH_JWT_REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_128_CHAR_HEX_STRING_GENERATED_BY_CRYPTO_RANDOMBYTES_64
AUTH_JWT_REFRESH_TOKEN_EXPIRED=7d
 
AUTH_SOCIAL_GOOGLE_CLIENT_ID=
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=
 
AUTH_SOCIAL_APPLE_CLIENT_ID=
AUTH_SOCIAL_APPLE_SIGN_IN_CLIENT_ID=
 
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_USERNAME="default"
REDIS_PASSWORD=
# REDIS_PASSWORD=default_pass
 
SENTRY_DSN=


# EMAIL CONFIGURATION

EMAIL_PROVIDER=

AZURE_EMAIL_CLIENT_ID=
AZURE_EMAIL_CLIENT_SECRET=
AZURE_EMAIL_TENANT_ID=
AZURE_EMAIL_FROM_EMAIL=
AZURE_EMAIL_FROM_NAME=


# EMAIL CREDENTIALS
# IMPORTANT: Use app-specific passwords for Gmail (not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_EMAIL="your-email@example.com"
SMTP_PASSWORD="your_app_specific_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SERVICE="gmail"
SMTP_SECURE=true
 
# PAYPAL CONFIGURATION
# Use sandbox for development, live for production
# NEVER commit production credentials to version control
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SEC_KEY=your_paypal_sandbox_secret_key
PAYPAL_CURRENCY=USD

# MULTI-TENANT CONFIGURATION
# CRITICAL SECURITY: Generate encryption key using:
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# This key encrypts tenant database credentials
# WARNING: NEVER change this key after initial setup - existing tenant data will become inaccessible
MULTI_TENANT_ENCRYPTION_KEY=REPLACE_WITH_64_CHAR_HEX_STRING_GENERATED_BY_CRYPTO_RANDOMBYTES_32

MULTI_TENANT_DATABASE_PREFIX=tenant_db_

# Connection Pool Configuration
MT_MAX_POOL_SIZE=10
MT_MIN_POOL_SIZE=2
MT_MAX_IDLE_TIME_MS=300000
MT_SERVER_SELECTION_TIMEOUT_MS=30000
MT_SOCKET_TIMEOUT_MS=30000
MT_HEARTBEAT_FREQUENCY_MS=10000

# System Limits
MT_MAX_TENANTS_PER_INSTANCE=100
MT_CONNECTION_TIMEOUT_MS=30000
MT_IDLE_TIMEOUT_MS=300000
MT_HEALTH_CHECK_INTERVAL_MS=60000

# Retry Configuration
MULTI_TENANT_MAX_RETRIES=3
MULTI_TENANT_BASE_DELAY=1000
MULTI_TENANT_MAX_DELAY=10000

# Tax related values
TAX_LABEL=
TAX_VALUE=


# AGENT COMMISSION
DEFAULT_AGENT_COMMISSION_PERCENTAGE=5

# OpenAI Configuration
OPENAI_API_KEY=

# Google Gemini Configuration
GEMINI_API_KEY=

TOOLS_INACTIVE_DELAY_MINUTES=



# Company Information (Required)
INVOICE_COMPANY_NAME=Amazon Edge
INVOICE_COMPANY_EMAIL=billing@ZonEdge.com
INVOICE_COMPANY_CONTACT=+441763272605
INVOICE_COMPANY_ADDRESS1=123 Main Street
INVOICE_COMPANY_ADDRESS2=Suite 100
INVOICE_COMPANY_TOWN=London
INVOICE_COMPANY_COUNTY=Greater London
INVOICE_COMPANY_POSTCODE=SW1A 1AA
INVOICE_VAT_NUMBER=GB123456789

# Invoice Settings (Required)
INVOICE_PREFIX=INV
INVOICE_PAYMENT_METHOD=Payment Method via PayPal

# General Configuration (Required)
MAIL_FROM_NAME=ZonEdge
IMAGE_DOMAIN=https://ZonEdge.com


INITIALIZE_SCHEDULER=false

TOOL_DELETION_QUEUE_NAME=tool-deletion
REDIS_DB=1

# APPOINTMENT APP SYNC CONFIGURATION
# MongoDB connection URI for the Appointment App database (MEAN stack app)
APPOINTMENT_DB_URI=mongodb://localhost:27017/appointgem_app

# Appointment App URL (for welcome email login link)
APPOINTMENT_APP_URL=https://app.appointgem.com

# Appointment App Org Admin Role ID (MongoDB ObjectId)
APPOINTMENT_ORG_ADMIN_ROLE=6088fe1f7dd5d402081167ee