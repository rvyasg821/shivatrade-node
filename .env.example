APP_NAME="ShivaTrades"
# Application mode: "single" = single-tenant ShivaTrade build (hides SaaS features)
# Set to "saas" only when re-enabling multi-tenant / subscription billing.
APP_MODE=single
APP_ENV=local
APP_LANGUAGE=en
APP_TIMEZONE="Asia/Kolkata"
 
HOME_URL=https://example.id
HOME_NAME="ShivaTrades"
 
HTTP_HOST=0.0.0.0
HTTP_PORT=3002
 
DEBUG_ENABLE=true
DEBUG_LEVEL=debug
DEBUG_INTO_FILE=false
DEBUG_PRETTIER=true
 
MIDDLEWARE_CORS_ORIGIN=*
 
URL_VERSIONING_ENABLE=true
URL_VERSION=1

FRONT_URL=
FRONT_LOGO_URL=

# IMPORTANT: Replace with your actual database credentials
# DO NOT commit actual credentials to version control
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=shivatrades_local
DATABASE_USERNAME=your_database_username
DATABASE_PASSWORD=your_strong_database_password
DATABASE_SYNC=true
DATABASE_DEBUG=false
 
AUTH_JWT_ISSUER=https://example.id
AUTH_JWT_AUDIENCE=RamsomBloc
 
# CRITICAL SECURITY: Generate strong secrets using:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# NEVER use these example values in any environment
AUTH_JWT_ACCESS_TOKEN_SECRET=REPLACE_WITH_128_CHAR_HEX_STRING_GENERATED_BY_CRYPTO_RANDOMBYTES_64
AUTH_JWT_ACCESS_TOKEN_EXPIRED=12h

# Generate a DIFFERENT secret for refresh tokens
AUTH_JWT_REFRESH_TOKEN_SECRET=REPLACE_WITH_DIFFERENT_128_CHAR_HEX_STRING_GENERATED_BY_CRYPTO_RANDOMBYTES_64
AUTH_JWT_REFRESH_TOKEN_EXPIRED=7d
 
AUTH_SOCIAL_GOOGLE_CLIENT_ID=
AUTH_SOCIAL_GOOGLE_CLIENT_SECRET=
 
AUTH_SOCIAL_APPLE_CLIENT_ID=
AUTH_SOCIAL_APPLE_SIGN_IN_CLIENT_ID=
 
REDIS_HOST="127.0.0.1"
REDIS_PORT=6379
REDIS_USERNAME="default"
REDIS_PASSWORD=
# REDIS_PASSWORD=default_pass
 
SENTRY_DSN=

# EMAIL CONFIGURATION => 'azure' | 'nodemailer'
EMAIL_PROVIDER=

AZURE_EMAIL_CLIENT_ID=
AZURE_EMAIL_CLIENT_SECRET=
AZURE_EMAIL_TENANT_ID=
AZURE_EMAIL_FROM_EMAIL=
AZURE_EMAIL_FROM_NAME=


# EMAIL CREDENTIALS
# IMPORTANT: Use app-specific passwords for Gmail (not your account password)
# https://support.google.com/accounts/answer/185833
SMTP_EMAIL="your-email@example.com"
SMTP_PASSWORD="your_app_specific_password"
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_SERVICE="gmail"
SMTP_SECURE=true
 
# PAYPAL CONFIGURATION
# Use sandbox for development, live for production
# NEVER commit production credentials to version control
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_paypal_sandbox_client_id
PAYPAL_SEC_KEY=your_paypal_sandbox_secret_key
PAYPAL_CURRENCY=USD

# Tax related values
TAX_LABEL=
TAX_VALUE=

# AGENT COMMISSION
DEFAULT_AGENT_COMMISSION_PERCENTAGE=5

TOOLS_INACTIVE_DELAY_MINUTES=

# Company Information (Required)
INVOICE_COMPANY_NAME=ShivaTrades
INVOICE_COMPANY_EMAIL=info@shivatradeimpex.com
INVOICE_COMPANY_CONTACT=+919227859625
INVOICE_COMPANY_ADDRESS1="FF-3 FF-4 Plot 1, Sun Building 1"
INVOICE_COMPANY_ADDRESS2="Abhishek Colony, Race Course Circle, Gotri"
INVOICE_COMPANY_TOWN="Vadodara Gujarat"
INVOICE_COMPANY_COUNTY=India
INVOICE_COMPANY_POSTCODE=390007
INVOICE_VAT_NUMBER=IN123456789

# Invoice Settings (Required)
INVOICE_PREFIX=INV
INVOICE_PAYMENT_METHOD=Payment Method via PayPal

# General Configuration (Required)
MAIL_FROM_NAME=ShivaTrades
IMAGE_DOMAIN=http://localhost:3001


INITIALIZE_SCHEDULER=false

TOOL_DELETION_QUEUE_NAME=tool-deletion
REDIS_DB=1

# Appointment App URL (for welcome email login link)
APPOINTMENT_APP_URL=http://localhost:3000

# Default password for admin-provisioned users (vendors, future invite flows).
# Users are expected to change it on first login.
DEFAULT_PASSWORD=Welcome@123
